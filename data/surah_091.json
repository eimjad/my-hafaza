[{"number":1,"text":"وَٱلشَّمۡسِ وَضُحَىٰهَا","textPlain":"والشمس وضحىٰها","page":595},{"number":2,"text":"وَٱلۡقَمَرِ إِذَا تَلَىٰهَا","textPlain":"والقمر اذا تلىٰها","page":595},{"number":3,"text":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","textPlain":"والنهار اذا جلىٰها","page":595},{"number":4,"text":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰهَا","textPlain":"واليل اذا يغشىٰها","page":595},{"number":5,"text":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","textPlain":"والسماء وما بنىٰها","page":595},{"number":6,"text":"وَٱلۡأَرۡضِ وَمَا طَحَىٰهَا","textPlain":"والارض وما طحىٰها","page":595},{"number":7,"text":"وَنَفۡسٖ وَمَا سَوَّىٰهَا","textPlain":"ونفس وما سوىٰها","page":595},{"number":8,"text":"فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىٰهَا","textPlain":"فالهمها فجورها وتقوىٰها","page":595},{"number":9,"text":"قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا","textPlain":"قد افلح من زكىٰها","page":595},{"number":10,"text":"وَقَدۡ خَابَ مَن دَسَّىٰهَا","textPlain":"وقد خاب من دسىٰها","page":595},{"number":11,"text":"كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَآ","textPlain":"كذبت ثمود بطغوىٰها","page":595},{"number":12,"text":"إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا","textPlain":"اذ انبعث اشقىٰها","page":595},{"number":13,"text":"فَقَالَ لَهُمۡ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡيَٰهَا","textPlain":"فقال لهم رسول الله ناقة الله وسقيٰها","page":595},{"number":14,"text":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوَّىٰهَا","textPlain":"فكذبوه فعقروها فدمدم عليهم ربهم بذنبهم فسوىٰها","page":595},{"number":15,"text":"وَلَا يَخَافُ عُقۡبَٰهَا","textPlain":"ولا يخاف عقبٰها","page":595}]