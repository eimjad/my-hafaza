[{"number":15,"text":"ثُمَّ يَطۡمَعُ أَنۡ أَزِيدَ","textPlain":"ثم يطمع ان ازيد","page":575},{"number":17,"text":"سَأُرۡهِقُهُۥ صَعُودًا","textPlain":"سارهقه صعودا","page":575},{"number":18,"text":"إِنَّهُۥ فَكَّرَ وَقَدَّرَ","textPlain":"انه فكر وقدر","page":575},{"number":19,"text":"فَقُتِلَ كَيۡفَ قَدَّرَ","textPlain":"فقتل كيف قدر","page":576},{"number":20,"text":"ثُمَّ قُتِلَ كَيۡفَ قَدَّرَ","textPlain":"ثم قتل كيف قدر","page":576},{"number":21,"text":"ثُمَّ نَظَرَ","textPlain":"ثم نظر","page":576},{"number":22,"text":"ثُمَّ عَبَسَ وَبَسَرَ","textPlain":"ثم عبس وبسر","page":576},{"number":23,"text":"ثُمَّ أَدۡبَرَ وَٱسۡتَكۡبَرَ","textPlain":"ثم ادبر واستكبر","page":576},{"number":47,"text":"حَتَّىٰٓ أَتَىٰنَا ٱلۡيَقِينُ","textPlain":"حتىٰ اتىٰنا اليقين","page":576},{"number":16,"text":"كَلَّآۖ إِنَّهُۥ كَانَ لِأٓيَٰتِنَا عَنِيدٗا","textPlain":"كلا انه كان لايٰتنا عنيدا","page":575},{"number":1,"text":"يَٰٓأَيُّهَا ٱلۡمُدَّثِّرُ","textPlain":"يٰايها المدثر","page":575},{"number":2,"text":"قُمۡ فَأَنذِرۡ","textPlain":"قم فانذر","page":575},{"number":3,"text":"وَرَبَّكَ فَكَبِّرۡ","textPlain":"وربك فكبر","page":575},{"number":4,"text":"وَثِيَابَكَ فَطَهِّرۡ","textPlain":"وثيابك فطهر","page":575},{"number":5,"text":"وَٱلرُّجۡزَ فَٱهۡجُرۡ","textPlain":"والرجز فاهجر","page":575},{"number":6,"text":"وَلَا تَمۡنُن تَسۡتَكۡثِرُ","textPlain":"ولا تمنن تستكثر","page":575},{"number":7,"text":"وَلِرَبِّكَ فَٱصۡبِرۡ","textPlain":"ولربك فاصبر","page":575},{"number":8,"text":"فَإِذَا نُقِرَ فِي ٱلنَّاقُورِ","textPlain":"فاذا نقر في الناقور","page":575},{"number":9,"text":"فَذَٰلِكَ يَوۡمَئِذٖ يَوۡمٌ عَسِيرٌ","textPlain":"فذٰلك يومئذ يوم عسير","page":575},{"number":10,"text":"عَلَى ٱلۡكَٰفِرِينَ غَيۡرُ يَسِيرٖ","textPlain":"على الكٰفرين غير يسير","page":575},{"number":11,"text":"ذَرۡنِي وَمَنۡ خَلَقۡتُ وَحِيدٗا","textPlain":"ذرني ومن خلقت وحيدا","page":575},{"number":12,"text":"وَجَعَلۡتُ لَهُۥ مَالٗا مَّمۡدُودٗا","textPlain":"وجعلت له مالا ممدودا","page":575},{"number":13,"text":"وَبَنِينَ شُهُودٗا","textPlain":"وبنين شهودا","page":575},{"number":14,"text":"وَمَهَّدتُّ لَهُۥ تَمۡهِيدٗا","textPlain":"ومهدت له تمهيدا","page":575},{"number":24,"text":"فَقَالَ إِنۡ هَٰذَآ إِلَّا سِحۡرٞ يُؤۡثَرُ","textPlain":"فقال ان هٰذا الا سحر يؤثر","page":576},{"number":25,"text":"إِنۡ هَٰذَآ إِلَّا قَوۡلُ ٱلۡبَشَرِ","textPlain":"ان هٰذا الا قول البشر","page":576},{"number":26,"text":"سَأُصۡلِيهِ سَقَرَ","textPlain":"ساصليه سقر","page":576},{"number":27,"text":"وَمَآ أَدۡرَىٰكَ مَا سَقَرُ","textPlain":"وما ادرىٰك ما سقر","page":576},{"number":28,"text":"لَا تُبۡقِي وَلَا تَذَرُ","textPlain":"لا تبقي ولا تذر","page":576},{"number":29,"text":"لَوَّاحَةٞ لِّلۡبَشَرِ","textPlain":"لواحة للبشر","page":576},{"number":30,"text":"عَلَيۡهَا تِسۡعَةَ عَشَرَ","textPlain":"عليها تسعة عشر","page":576},{"number":31,"text":"وَمَا جَعَلۡنَآ أَصۡحَٰبَ ٱلنَّارِ إِلَّا مَلَٰٓئِكَةٗۖ وَمَا جَعَلۡنَا عِدَّتَهُمۡ إِلَّا فِتۡنَةٗ لِّلَّذِينَ كَفَرُواْ لِيَسۡتَيۡقِنَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَيَزۡدَادَ ٱلَّذِينَ ءَامَنُوٓاْ إِيمَٰنٗا وَلَا يَرۡتَابَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَٱلۡمُؤۡمِنُونَ وَلِيَقُولَ ٱلَّذِينَ فِي قُلُوبِهِم مَّرَضٞ وَٱلۡكَٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلٗاۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهۡدِي مَن يَشَآءُۚ وَمَا يَعۡلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَۚ وَمَا هِيَ إِلَّا ذِكۡرَىٰ لِلۡبَشَرِ","textPlain":"وما جعلنا اصحٰب النار الا ملٰئكة وما جعلنا عدتهم الا فتنة للذين كفروا ليستيقن الذين اوتوا الكتٰب ويزداد الذين ءامنوا ايمٰنا ولا يرتاب الذين اوتوا الكتٰب والمؤمنون وليقول الذين في قلوبهم مرض والكٰفرون ماذا اراد الله بهٰذا مثلا كذٰلك يضل الله من يشاء ويهدي من يشاء وما يعلم جنود ربك الا هو وما هي الا ذكرىٰ للبشر","page":576},{"number":32,"text":"كَلَّا وَٱلۡقَمَرِ","textPlain":"كلا والقمر","page":576},{"number":33,"text":"وَٱلَّيۡلِ إِذۡ أَدۡبَرَ","textPlain":"واليل اذ ادبر","page":576},{"number":34,"text":"وَٱلصُّبۡحِ إِذَآ أَسۡفَرَ","textPlain":"والصبح اذا اسفر","page":576},{"number":35,"text":"إِنَّهَا لَإِحۡدَى ٱلۡكُبَرِ","textPlain":"انها لاحدى الكبر","page":576},{"number":36,"text":"نَذِيرٗا لِّلۡبَشَرِ","textPlain":"نذيرا للبشر","page":576},{"number":37,"text":"لِمَن شَآءَ مِنكُمۡ أَن يَتَقَدَّمَ أَوۡ يَتَأَخَّرَ","textPlain":"لمن شاء منكم ان يتقدم او يتاخر","page":576},{"number":38,"text":"كُلُّ نَفۡسِۭ بِمَا كَسَبَتۡ رَهِينَةٌ","textPlain":"كل نفس بما كسبت رهينة","page":576},{"number":39,"text":"إِلَّآ أَصۡحَٰبَ ٱلۡيَمِينِ","textPlain":"الا اصحٰب اليمين","page":576},{"number":40,"text":"فِي جَنَّٰتٖ يَتَسَآءَلُونَ","textPlain":"في جنٰت يتساءلون","page":576},{"number":41,"text":"عَنِ ٱلۡمُجۡرِمِينَ","textPlain":"عن المجرمين","page":576},{"number":42,"text":"مَا سَلَكَكُمۡ فِي سَقَرَ","textPlain":"ما سلككم في سقر","page":576},{"number":43,"text":"قَالُواْ لَمۡ نَكُ مِنَ ٱلۡمُصَلِّينَ","textPlain":"قالوا لم نك من المصلين","page":576},{"number":44,"text":"وَلَمۡ نَكُ نُطۡعِمُ ٱلۡمِسۡكِينَ","textPlain":"ولم نك نطعم المسكين","page":576},{"number":45,"text":"وَكُنَّا نَخُوضُ مَعَ ٱلۡخَآئِضِينَ","textPlain":"وكنا نخوض مع الخائضين","page":576},{"number":46,"text":"وَكُنَّا نُكَذِّبُ بِيَوۡمِ ٱلدِّينِ","textPlain":"وكنا نكذب بيوم الدين","page":576},{"number":48,"text":"فَمَا تَنفَعُهُمۡ شَفَٰعَةُ ٱلشَّٰفِعِينَ","textPlain":"فما تنفعهم شفٰعة الشٰفعين","page":577},{"number":49,"text":"فَمَا لَهُمۡ عَنِ ٱلتَّذۡكِرَةِ مُعۡرِضِينَ","textPlain":"فما لهم عن التذكرة معرضين","page":577},{"number":50,"text":"كَأَنَّهُمۡ حُمُرٞ مُّسۡتَنفِرَةٞ","textPlain":"كانهم حمر مستنفرة","page":577},{"number":51,"text":"فَرَّتۡ مِن قَسۡوَرَةِۭ","textPlain":"فرت من قسورة","page":577},{"number":52,"text":"بَلۡ يُرِيدُ كُلُّ ٱمۡرِيٕٖ مِّنۡهُمۡ أَن يُؤۡتَىٰ صُحُفٗا مُّنَشَّرَةٗ","textPlain":"بل يريد كل امري منهم ان يؤتىٰ صحفا منشرة","page":577},{"number":53,"text":"كَلَّاۖ بَل لَّا يَخَافُونَ ٱلۡأٓخِرَةَ","textPlain":"كلا بل لا يخافون الاخرة","page":577},{"number":54,"text":"كَلَّآ إِنَّهُۥ تَذۡكِرَةٞ","textPlain":"كلا انه تذكرة","page":577},{"number":55,"text":"فَمَن شَآءَ ذَكَرَهُۥ","textPlain":"فمن شاء ذكره","page":577},{"number":56,"text":"وَمَا يَذۡكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ هُوَ أَهۡلُ ٱلتَّقۡوَىٰ وَأَهۡلُ ٱلۡمَغۡفِرَةِ","textPlain":"وما يذكرون الا ان يشاء الله هو اهل التقوىٰ واهل المغفرة","page":577}]