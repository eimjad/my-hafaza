[{"number":1,"text":"لَآ أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ","textPlain":"لا اقسم بهٰذا البلد","page":594},{"number":2,"text":"وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ","textPlain":"وانت حل بهٰذا البلد","page":594},{"number":3,"text":"وَوَالِدٖ وَمَا وَلَدَ","textPlain":"ووالد وما ولد","page":594},{"number":4,"text":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ","textPlain":"لقد خلقنا الانسٰن في كبد","page":594},{"number":5,"text":"أَيَحۡسَبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدٞ","textPlain":"ايحسب ان لن يقدر عليه احد","page":594},{"number":6,"text":"يَقُولُ أَهۡلَكۡتُ مَالٗا لُّبَدًا","textPlain":"يقول اهلكت مالا لبدا","page":594},{"number":7,"text":"أَيَحۡسَبُ أَن لَّمۡ يَرَهُۥٓ أَحَدٌ","textPlain":"ايحسب ان لم يره احد","page":594},{"number":8,"text":"أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ","textPlain":"الم نجعل له عينين","page":594},{"number":9,"text":"وَلِسَانٗا وَشَفَتَيۡنِ","textPlain":"ولسانا وشفتين","page":594},{"number":10,"text":"وَهَدَيۡنَٰهُ ٱلنَّجۡدَيۡنِ","textPlain":"وهدينٰه النجدين","page":594},{"number":11,"text":"فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ","textPlain":"فلا اقتحم العقبة","page":594},{"number":12,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ","textPlain":"وما ادرىٰك ما العقبة","page":594},{"number":13,"text":"فَكُّ رَقَبَةٍ","textPlain":"فك رقبة","page":594},{"number":14,"text":"أَوۡ إِطۡعَٰمٞ فِي يَوۡمٖ ذِي مَسۡغَبَةٖ","textPlain":"او اطعٰم في يوم ذي مسغبة","page":594},{"number":15,"text":"يَتِيمٗا ذَا مَقۡرَبَةٍ","textPlain":"يتيما ذا مقربة","page":594},{"number":16,"text":"أَوۡ مِسۡكِينٗا ذَا مَتۡرَبَةٖ","textPlain":"او مسكينا ذا متربة","page":594},{"number":17,"text":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ وَتَوَاصَوۡاْ بِٱلۡمَرۡحَمَةِ","textPlain":"ثم كان من الذين ءامنوا وتواصوا بالصبر وتواصوا بالمرحمة","page":594},{"number":18,"text":"أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ","textPlain":"اولٰئك اصحٰب الميمنة","page":594},{"number":19,"text":"وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمۡ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ","textPlain":"والذين كفروا بايٰتنا هم اصحٰب المشمة","page":595},{"number":20,"text":"عَلَيۡهِمۡ نَارٞ مُّؤۡصَدَةُۢ","textPlain":"عليهم نار مؤصدة","page":595}]