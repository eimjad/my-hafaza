[{"number":21,"text":"وَلَسَوۡفَ يَرۡضَىٰ","textPlain":"ولسوف يرضىٰ","page":596},{"number":1,"text":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰ","textPlain":"واليل اذا يغشىٰ","page":595},{"number":2,"text":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","textPlain":"والنهار اذا تجلىٰ","page":595},{"number":3,"text":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ","textPlain":"وما خلق الذكر والانثىٰ","page":595},{"number":4,"text":"إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ","textPlain":"ان سعيكم لشتىٰ","page":595},{"number":5,"text":"فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ","textPlain":"فاما من اعطىٰ واتقىٰ","page":595},{"number":6,"text":"وَصَدَّقَ بِٱلۡحُسۡنَىٰ","textPlain":"وصدق بالحسنىٰ","page":595},{"number":7,"text":"فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ","textPlain":"فسنيسره لليسرىٰ","page":595},{"number":8,"text":"وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ","textPlain":"واما من بخل واستغنىٰ","page":595},{"number":9,"text":"وَكَذَّبَ بِٱلۡحُسۡنَىٰ","textPlain":"وكذب بالحسنىٰ","page":595},{"number":10,"text":"فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ","textPlain":"فسنيسره للعسرىٰ","page":596},{"number":11,"text":"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","textPlain":"وما يغني عنه ماله اذا تردىٰ","page":596},{"number":12,"text":"إِنَّ عَلَيۡنَا لَلۡهُدَىٰ","textPlain":"ان علينا للهدىٰ","page":596},{"number":13,"text":"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ","textPlain":"وان لنا للاخرة والاولىٰ","page":596},{"number":14,"text":"فَأَنذَرۡتُكُمۡ نَارٗا تَلَظَّىٰ","textPlain":"فانذرتكم نارا تلظىٰ","page":596},{"number":15,"text":"لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى","textPlain":"لا يصلىٰها الا الاشقى","page":596},{"number":16,"text":"ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ","textPlain":"الذي كذب وتولىٰ","page":596},{"number":17,"text":"وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى","textPlain":"وسيجنبها الاتقى","page":596},{"number":18,"text":"ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ","textPlain":"الذي يؤتي ماله يتزكىٰ","page":596},{"number":19,"text":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٖ تُجۡزَىٰٓ","textPlain":"وما لاحد عنده من نعمة تجزىٰ","page":596},{"number":20,"text":"إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ","textPlain":"الا ابتغاء وجه ربه الاعلىٰ","page":596}]