[{"number":1,"text":"قُلۡ هُوَ ٱللَّهُ أَحَدٌ","textPlain":"قل هو الله احد","page":604},{"number":2,"text":"ٱللَّهُ ٱلصَّمَدُ","textPlain":"الله الصمد","page":604},{"number":3,"text":"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ","textPlain":"لم يلد ولم يولد","page":604},{"number":4,"text":"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ","textPlain":"ولم يكن له كفوا احد","page":604}]