:449},{"number":101,"text":"فَبَشَّرۡنَٰهُ بِغُلَٰمٍ حَلِيمٖ","textPlain":"فبشرنٰه بغلٰم حليم","page":449},{"number":124,"text":"إِذۡ قَالَ لِقَوۡمِهِۦٓ أَلَا تَتَّقُونَ","textPlain":"اذ قال لقومه الا تتقون","page":450},{"number":102,"text":"فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعۡيَ قَالَ يَٰبُنَيَّ إِنِّيٓ أَرَىٰ فِي ٱلۡمَنَامِ أَنِّيٓ أَذۡبَحُكَ فَٱنظُرۡ مَاذَا تَرَىٰۚ قَالَ يَٰٓأَبَتِ ٱفۡعَلۡ مَا تُؤۡمَرُۖ سَتَجِدُنِيٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّٰبِرِينَ","textPlain":"فلما بلغ معه السعي قال يٰبني اني ارىٰ في المنام اني اذبحك فانظر ماذا ترىٰ قال يٰابت افعل ما تؤمر ستجدني ان شاء الله من الصٰبرين","page":449},{"number":103,"text":"فَلَمَّآ أَسۡلَمَا وَتَلَّهُۥ لِلۡجَبِينِ","textPlain":"فلما اسلما وتله للجبين","page":450},{"number":104,"text":"وَنَٰدَيۡنَٰهُ أَن يَٰٓإِبۡرَٰهِيمُ","textPlain":"ونٰدينٰه ان يٰابرٰهيم","page":450},{"number":105,"text":"قَدۡ صَدَّقۡتَ ٱلرُّءۡيَآۚ إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","textPlain":"قد صدقت الرءيا انا كذٰلك نجزي المحسنين","page":450},{"number":106,"text":"إِنَّ هَٰذَا لَهُوَ ٱلۡبَلَٰٓؤُاْ ٱلۡمُبِينُ","textPlain":"ان هٰذا لهو البلٰؤا المبين","page":450},{"number":107,"text":"وَفَدَيۡنَٰهُ بِذِبۡحٍ عَظِيمٖ","textPlain":"وفدينٰه بذبح عظيم","page":450},{"number":108,"text":"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ","textPlain":"وتركنا عليه في الاخرين","page":450},{"number":109,"text":"سَلَٰمٌ عَلَىٰٓ إِبۡرَٰهِيمَ","textPlain":"سلٰم علىٰ ابرٰهيم","page":450},{"number":110,"text":"كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","textPlain":"كذٰلك نجزي المحسنين","page":450},{"number":111,"text":"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ","textPlain":"انه من عبادنا المؤمنين","page":450},{"number":112,"text":"وَبَشَّرۡنَٰهُ بِإِسۡحَٰقَ نَبِيّٗا مِّنَ ٱلصَّٰلِحِينَ","textPlain":"وبشرنٰه باسحٰق نبيا من الصٰلحين","page":450},{"number":113,"text":"وَبَٰرَكۡنَا عَلَيۡهِ وَعَلَىٰٓ إِسۡحَٰقَۚ وَمِن ذُرِّيَّتِهِمَا مُحۡسِنٞ وَظَالِمٞ لِّنَفۡسِهِۦ مُبِينٞ","textPlain":"وبٰركنا عليه وعلىٰ اسحٰق ومن ذريتهما محسن وظالم لنفسه مبين","page":450},{"number":114,"text":"وَلَقَدۡ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ","textPlain":"ولقد مننا علىٰ موسىٰ وهٰرون","page":450},{"number":115,"text":"وَنَجَّيۡنَٰهُمَا وَقَوۡمَهُمَا مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ","textPlain":"ونجينٰهما وقومهما من الكرب العظيم","page":450},{"number":116,"text":"وَنَصَرۡنَٰهُمۡ فَكَانُواْ هُمُ ٱلۡغَٰلِبِينَ","textPlain":"ونصرنٰهم فكانوا هم الغٰلبين","page":450},{"number":117,"text":"وَءَاتَيۡنَٰهُمَا ٱلۡكِتَٰبَ ٱلۡمُسۡتَبِينَ","textPlain":"وءاتينٰهما الكتٰب المستبين","page":450},{"number":118,"text":"وَهَدَيۡنَٰهُمَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ","textPlain":"وهدينٰهما الصرٰط المستقيم","page":450},{"number":119,"text":"وَتَرَكۡنَا عَلَيۡهِمَا فِي ٱلۡأٓخِرِينَ","textPlain":"وتركنا عليهما في الاخرين","page":450},{"number":120,"text":"سَلَٰمٌ عَلَىٰ مُوسَىٰ وَهَٰرُونَ","textPlain":"سلٰم علىٰ موسىٰ وهٰرون","page":450},{"number":121,"text":"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","textPlain":"انا كذٰلك نجزي المحسنين","page":450},{"number":122,"text":"إِنَّهُمَا مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ","textPlain":"انهما من عبادنا المؤمنين","page":450},{"number":123,"text":"وَإِنَّ إِلۡيَاسَ لَمِنَ ٱلۡمُرۡسَلِينَ","textPlain":"وان الياس لمن المرسلين","page":450},{"number":125,"text":"أَتَدۡعُونَ بَعۡلٗا وَتَذَرُونَ أَحۡسَنَ ٱلۡخَٰلِقِينَ","textPlain":"اتدعون بعلا وتذرون احسن الخٰلقين","page":450},{"number":126,"text":"ٱللَّهَ رَبَّكُمۡ وَرَبَّ ءَابَآئِكُمُ ٱلۡأَوَّلِينَ","textPlain":"الله ربكم ورب ءابائكم الاولين","page":450},{"number":127,"text":"فَكَذَّبُوهُ فَإِنَّهُمۡ لَمُحۡضَرُونَ","textPlain":"فكذبوه فانهم لمحضرون","page":451},{"number":128,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ","textPlain":"الا عباد الله المخلصين","page":451},{"number":129,"text":"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ","textPlain":"وتركنا عليه في الاخرين","page":451},{"number":130,"text":"سَلَٰمٌ عَلَىٰٓ إِلۡ يَاسِينَ","textPlain":"سلٰم علىٰ ال ياسين","page":451},{"number":131,"text":"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","textPlain":"انا كذٰلك نجزي المحسنين","page":451},{"number":132,"text":"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ","textPlain":"انه من عبادنا المؤمنين","page":451},{"number":133,"text":"وَإِنَّ لُوطٗا لَّمِنَ ٱلۡمُرۡسَلِينَ","textPlain":"وان لوطا لمن المرسلين","page":451},{"number":134,"text":"إِذۡ نَجَّيۡنَٰهُ وَأَهۡلَهُۥٓ أَجۡمَعِينَ","textPlain":"اذ نجينٰه واهله اجمعين","page":451},{"number":135,"text":"إِلَّا عَجُوزٗا فِي ٱلۡغَٰبِرِينَ","textPlain":"الا عجوزا في الغٰبرين","page":451},{"number":136,"text":"ثُمَّ دَمَّرۡنَا ٱلۡأٓخَرِينَ","textPlain":"ثم دمرنا الاخرين","page":451},{"number":137,"text":"وَإِنَّكُمۡ لَتَمُرُّونَ عَلَيۡهِم مُّصۡبِحِينَ","textPlain":"وانكم لتمرون عليهم مصبحين","page":451},{"number":138,"text":"وَبِٱلَّيۡلِۚ أَفَلَا تَعۡقِلُونَ","textPlain":"وباليل افلا تعقلون","page":451},{"number":139,"text":"وَإِنَّ يُونُسَ لَمِنَ ٱلۡمُرۡسَلِينَ","textPlain":"وان يونس لمن المرسلين","page":451},{"number":140,"text":"إِذۡ أَبَقَ إِلَى ٱلۡفُلۡكِ ٱلۡمَشۡحُونِ","textPlain":"اذ ابق الى الفلك المشحون","page":451},{"number":141,"text":"فَسَاهَمَ فَكَانَ مِنَ ٱلۡمُدۡحَضِينَ","textPlain":"فساهم فكان من المدحضين","page":451},{"number":142,"text":"فَٱلۡتَقَمَهُ ٱلۡحُوتُ وَهُوَ مُلِيمٞ","textPlain":"فالتقمه الحوت وهو مليم","page":451},{"number":143,"text":"فَلَوۡلَآ أَنَّهُۥ كَانَ مِنَ ٱلۡمُسَبِّحِينَ","textPlain":"فلولا انه كان من المسبحين","page":451},{"number":144,"text":"لَلَبِثَ فِي بَطۡنِهِۦٓ إِلَىٰ يَوۡمِ يُبۡعَثُونَ","textPlain":"للبث في بطنه الىٰ يوم يبعثون","page":451},{"number":145,"text":"۞فَنَبَذۡنَٰهُ بِٱلۡعَرَآءِ وَهُوَ سَقِيمٞ","textPlain":"فنبذنٰه بالعراء وهو سقيم","page":451},{"number":146,"text":"وَأَنۢبَتۡنَا عَلَيۡهِ شَجَرَةٗ مِّن يَقۡطِينٖ","textPlain":"وانبتنا عليه شجرة من يقطين","page":451},{"number":147,"text":"وَأَرۡسَلۡنَٰهُ إِلَىٰ مِاْئَةِ أَلۡفٍ أَوۡ يَزِيدُونَ","textPlain":"وارسلنٰه الىٰ مائة الف او يزيدون","page":451},{"number":148,"text":"فَـَٔامَنُواْ فَمَتَّعۡنَٰهُمۡ إِلَىٰ حِينٖ","textPlain":"فامنوا فمتعنٰهم الىٰ حين","page":451},{"number":149,"text":"فَٱسۡتَفۡتِهِمۡ أَلِرَبِّكَ ٱلۡبَنَاتُ وَلَهُمُ ٱلۡبَنُونَ","textPlain":"فاستفتهم الربك البنات ولهم البنون","page":451},{"number":150,"text":"أَمۡ خَلَقۡنَا ٱلۡمَلَٰٓئِكَةَ إِنَٰثٗا وَهُمۡ شَٰهِدُونَ","textPlain":"ام خلقنا الملٰئكة انٰثا وهم شٰهدون","page":451},{"number":151,"text":"أَلَآ إِنَّهُم مِّنۡ إِفۡكِهِمۡ لَيَقُولُونَ","textPlain":"الا انهم من افكهم ليقولون","page":451},{"number":152,"text":"وَلَدَ ٱللَّهُ وَإِنَّهُمۡ لَكَٰذِبُونَ","textPlain":"ولد الله وانهم لكٰذبون","page":451},{"number":153,"text":"أَصۡطَفَى ٱلۡبَنَاتِ عَلَى ٱلۡبَنِينَ","textPlain":"اصطفى البنات على البنين","page":451},{"number":154,"text":"مَا لَكُمۡ كَيۡفَ تَحۡكُمُونَ","textPlain":"ما لكم كيف تحكمون","page":452},{"number":155,"text":"أَفَلَا تَذَكَّرُونَ","textPlain":"افلا تذكرون","page":452},{"number":156,"text":"أَمۡ لَكُمۡ سُلۡطَٰنٞ مُّبِينٞ","textPlain":"ام لكم سلطٰن مبين","page":452},{"number":157,"text":"فَأۡتُواْ بِكِتَٰبِكُمۡ إِن كُنتُمۡ صَٰدِقِينَ","textPlain":"فاتوا بكتٰبكم ان كنتم صٰدقين","page":452},{"number":158,"text":"وَجَعَلُواْ بَيۡنَهُۥ وَبَيۡنَ ٱلۡجِنَّةِ نَسَبٗاۚ وَلَقَدۡ عَلِمَتِ ٱلۡجِنَّةُ إِنَّهُمۡ لَمُحۡضَرُونَ","textPlain":"وجعلوا بينه وبين الجنة نسبا ولقد علمت الجنة انهم لمحضرون","page":452},{"number":159,"text":"سُبۡحَٰنَ ٱللَّهِ عَمَّا يَصِفُونَ","textPlain":"سبحٰن الله عما يصفون","page":452},{"number":160,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ","textPlain":"الا عباد الله المخلصين","page":452},{"number":161,"text":"فَإِنَّكُمۡ وَمَا تَعۡبُدُونَ","textPlain":"فانكم وما تعبدون","page":452},{"number":162,"text":"مَآ أَنتُمۡ عَلَيۡهِ بِفَٰتِنِينَ","textPlain":"ما انتم عليه بفٰتنين","page":452},{"number":163,"text":"إِلَّا مَنۡ هُوَ صَالِ ٱلۡجَحِيمِ","textPlain":"الا من هو صال الجحيم","page":452},{"number":164,"text":"وَمَامِنَّآ إِلَّا لَهُۥ مَقَامٞ مَّعۡلُومٞ","textPlain":"ومامنا الا له مقام معلوم","page":452},{"number":165,"text":"وَإِنَّا لَنَحۡنُ ٱلصَّآفُّونَ","textPlain":"وانا لنحن الصافون","page":452},{"number":166,"text":"وَإِنَّا لَنَحۡنُ ٱلۡمُسَبِّحُونَ","textPlain":"وانا لنحن المسبحون","page":452},{"number":167,"text":"وَإِن كَانُواْ لَيَقُولُونَ","textPlain":"وان كانوا ليقولون","page":452},{"number":168,"text":"لَوۡ أَنَّ عِندَنَا ذِكۡرٗا مِّنَ ٱلۡأَوَّلِينَ","textPlain":"لو ان عندنا ذكرا من الاولين","page":452},{"number":169,"text":"لَكُنَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ","textPlain":"لكنا عباد الله المخلصين","page":452},{"number":170,"text":"فَكَفَرُواْ بِهِۦۖ فَسَوۡفَ يَعۡلَمُونَ","textPlain":"فكفروا به فسوف يعلمون","page":452},{"number":171,"text":"وَلَقَدۡ سَبَقَتۡ كَلِمَتُنَا لِعِبَادِنَا ٱلۡمُرۡسَلِينَ","textPlain":"ولقد سبقت كلمتنا لعبادنا المرسلين","page":452},{"number":172,"text":"إِنَّهُمۡ لَهُمُ ٱلۡمَنصُورُونَ","textPlain":"انهم لهم المنصورون","page":452},{"number":173,"text":"وَإِنَّ جُندَنَا لَهُمُ ٱلۡغَٰلِبُونَ","textPlain":"وان جندنا لهم الغٰلبون","page":452},{"number":174,"text":"فَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِينٖ","textPlain":"فتول عنهم حتىٰ حين","page":452},{"number":175,"text":"وَأَبۡصِرۡهُمۡ فَسَوۡفَ يُبۡصِرُونَ","textPlain":"وابصرهم فسوف يبصرون","page":452},{"number":176,"text":"أَفَبِعَذَابِنَا يَسۡتَعۡجِلُونَ","textPlain":"افبعذابنا يستعجلون","page":452},{"number":177,"text":"فَإِذَا نَزَلَ بِسَاحَتِهِمۡ فَسَآءَ صَبَاحُ ٱلۡمُنذَرِينَ","textPlain":"فاذا نزل بساحتهم فساء صباح المنذرين","page":452},{"number":178,"text":"وَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِينٖ","textPlain":"وتول عنهم حتىٰ حين","page":452},{"number":179,"text":"وَأَبۡصِرۡ فَسَوۡفَ يُبۡصِرُونَ","textPlain":"وابصر فسوف يبصرون","page":452},{"number":180,"text":"سُبۡحَٰنَ رَبِّكَ رَبِّ ٱلۡعِزَّةِ عَمَّا يَصِفُونَ","textPlain":"سبحٰن ربك رب العزة عما يصفون","page":452},{"number":181,"text":"وَسَلَٰمٌ عَلَى ٱلۡمُرۡسَلِينَ","textPlain":"وسلٰم على المرسلين","page":452},{"number":182,"text":"وَٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ","textPlain":"والحمد لله رب العٰلمين","page":452}]