[{"number":1,"text":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ","textPlain":"اذا السماء انفطرت","page":587},{"number":2,"text":"وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ","textPlain":"واذا الكواكب انتثرت","page":587},{"number":3,"text":"وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ","textPlain":"واذا البحار فجرت","page":587},{"number":4,"text":"وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ","textPlain":"واذا القبور بعثرت","page":587},{"number":5,"text":"عَلِمَتۡ نَفۡسٞ مَّا قَدَّمَتۡ وَأَخَّرَتۡ","textPlain":"علمت نفس ما قدمت واخرت","page":587},{"number":6,"text":"يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ","textPlain":"يٰايها الانسٰن ما غرك بربك الكريم","page":587},{"number":7,"text":"ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","textPlain":"الذي خلقك فسوىٰك فعدلك","page":587},{"number":8,"text":"فِيٓ أَيِّ صُورَةٖ مَّا شَآءَ رَكَّبَكَ","textPlain":"في اي صورة ما شاء ركبك","page":587},{"number":9,"text":"كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ","textPlain":"كلا بل تكذبون بالدين","page":587},{"number":10,"text":"وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ","textPlain":"وان عليكم لحٰفظين","page":587},{"number":11,"text":"كِرَامٗا كَٰتِبِينَ","textPlain":"كراما كٰتبين","page":587},{"number":12,"text":"يَعۡلَمُونَ مَا تَفۡعَلُونَ","textPlain":"يعلمون ما تفعلون","page":587},{"number":13,"text":"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمٖ","textPlain":"ان الابرار لفي نعيم","page":587},{"number":14,"text":"وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمٖ","textPlain":"وان الفجار لفي جحيم","page":587},{"number":15,"text":"يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ","textPlain":"يصلونها يوم الدين","page":587},{"number":16,"text":"وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ","textPlain":"وما هم عنها بغائبين","page":587},{"number":17,"text":"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ","textPlain":"وما ادرىٰك ما يوم الدين","page":587},{"number":18,"text":"ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ","textPlain":"ثم ما ادرىٰك ما يوم الدين","page":587},{"number":19,"text":"يَوۡمَ لَا تَمۡلِكُ نَفۡسٞ لِّنَفۡسٖ شَيۡـٔٗاۖ وَٱلۡأَمۡرُ يَوۡمَئِذٖ لِّلَّهِ","textPlain":"يوم لا تملك نفس لنفس شيا والامر يومئذ لله","page":587}]