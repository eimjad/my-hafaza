[{"number":1,"text":"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ","textPlain":"ويل لكل همزة لمزة","page":601},{"number":2,"text":"ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ","textPlain":"الذي جمع مالا وعدده","page":601},{"number":3,"text":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ","textPlain":"يحسب ان ماله اخلده","page":601},{"number":4,"text":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ","textPlain":"كلا لينبذن في الحطمة","page":601},{"number":5,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ","textPlain":"وما ادرىٰك ما الحطمة","page":601},{"number":6,"text":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ","textPlain":"نار الله الموقدة","page":601},{"number":7,"text":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ","textPlain":"التي تطلع على الافدة","page":601},{"number":8,"text":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ","textPlain":"انها عليهم مؤصدة","page":601},{"number":9,"text":"فِي عَمَدٖ مُّمَدَّدَةِۭ","textPlain":"في عمد ممددة","page":601}]