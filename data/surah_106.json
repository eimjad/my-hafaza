[{"number":1,"text":"لِإِيلَٰفِ قُرَيۡشٍ","textPlain":"لايلٰف قريش","page":602},{"number":2,"text":"إِۦلَٰفِهِمۡ رِحۡلَةَ ٱلشِّتَآءِ وَٱلصَّيۡفِ","textPlain":"الٰفهم رحلة الشتاء والصيف","page":602},{"number":3,"text":"فَلۡيَعۡبُدُواْ رَبَّ هَٰذَا ٱلۡبَيۡتِ","textPlain":"فليعبدوا رب هٰذا البيت","page":602},{"number":4,"text":"ٱلَّذِيٓ أَطۡعَمَهُم مِّن جُوعٖ وَءَامَنَهُم مِّنۡ خَوۡفِۭ","textPlain":"الذي اطعمهم من جوع وءامنهم من خوف","page":602}]