[{"number":1,"text":"وَٱلۡعَٰدِيَٰتِ ضَبۡحٗا","textPlain":"والعٰديٰت ضبحا","page":599},{"number":2,"text":"فَٱلۡمُورِيَٰتِ قَدۡحٗا","textPlain":"فالموريٰت قدحا","page":599},{"number":3,"text":"فَٱلۡمُغِيرَٰتِ صُبۡحٗا","textPlain":"فالمغيرٰت صبحا","page":599},{"number":4,"text":"فَأَثَرۡنَ بِهِۦ نَقۡعٗا","textPlain":"فاثرن به نقعا","page":599},{"number":5,"text":"فَوَسَطۡنَ بِهِۦ جَمۡعًا","textPlain":"فوسطن به جمعا","page":599},{"number":6,"text":"إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ","textPlain":"ان الانسٰن لربه لكنود","page":600},{"number":7,"text":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ","textPlain":"وانه علىٰ ذٰلك لشهيد","page":600},{"number":8,"text":"وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ","textPlain":"وانه لحب الخير لشديد","page":600},{"number":9,"text":"۞أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ","textPlain":"افلا يعلم اذا بعثر ما في القبور","page":600},{"number":10,"text":"وَحُصِّلَ مَا فِي ٱلصُّدُورِ","textPlain":"وحصل ما في الصدور","page":600},{"number":11,"text":"إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذٖ لَّخَبِيرُۢ","textPlain":"ان ربهم بهم يومئذ لخبير","page":600}]