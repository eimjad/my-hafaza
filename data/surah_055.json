ء ربكما تكذبان","page":531},{"number":19,"text":"مَرَجَ ٱلۡبَحۡرَيۡنِ يَلۡتَقِيَانِ","textPlain":"مرج البحرين يلتقيان","page":532},{"number":20,"text":"بَيۡنَهُمَا بَرۡزَخٞ لَّا يَبۡغِيَانِ","textPlain":"بينهما برزخ لا يبغيان","page":532},{"number":21,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","textPlain":"فباي ءالاء ربكما تكذبان","page":532},{"number":22,"text":"يَخۡرُجُ مِنۡهُمَا ٱللُّؤۡلُؤُ وَٱلۡمَرۡجَانُ","textPlain":"يخرج منهما اللؤلؤ والمرجان","page":532},{"number":23,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","textPlain":"فباي ءالاء ربكما تكذبان","page":532},{"number":24,"text":"وَلَهُ ٱلۡجَوَارِ ٱلۡمُنشَـَٔاتُ فِي ٱلۡبَحۡرِ كَٱلۡأَعۡلَٰمِ","textPlain":"وله الجوار المنشات في البحر كالاعلٰم","page":532},{"number":25,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","textPlain":"فباي ءالاء ربكما تكذبان","page":532},{"number":26,"text":"كُلُّ مَنۡ عَلَيۡهَا فَانٖ","textPlain":"كل من عليها فان","page":532},{"number":27,"text":"وَيَبۡقَىٰ وَجۡهُ رَبِّكَ ذُو ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ","textPlain":"ويبقىٰ وجه ربك ذو الجلٰل والاكرام","page":532},{"number":28,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","textPlain":"فباي ءالاء ربكما تكذبان","page":532},{"number":29,"text":"يَسۡـَٔلُهُۥ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ كُلَّ يَوۡمٍ هُوَ فِي شَأۡنٖ","textPlain":"يسله من في السمٰوٰت والارض كل يوم هو في شان","page":532},{"number":30,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","textPlain":"فباي ءالاء ربكما تكذبان","page":532},{"number":31,"text":"سَنَفۡرُغُ لَكُمۡ أَيُّهَ ٱلثَّقَلَانِ","textPlain":"سنفرغ لكم ايه الثقلان","page":532},{"number":32,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","textPlain":"فباي ءالاء ربكما تكذبان","page":532},{"number":33,"text":"يَٰمَعۡشَرَ ٱلۡجِنِّ وَٱلۡإِنسِ إِنِ ٱسۡتَطَعۡتُمۡ أَن تَنفُذُواْ مِنۡ أَقۡطَارِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ فَٱنفُذُواْۚ لَا تَنفُذُونَ إِلَّا بِسُلۡطَٰنٖ","textPlain":"يٰمعشر الجن والانس ان استطعتم ان تنفذوا من اقطار السمٰوٰت والارض فانفذوا لا تنفذون الا بسلطٰن","page":532},{"number":34,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","textPlain":"فباي ءالاء ربكما تكذبان","page":532},{"number":35,"text":"يُرۡسَلُ عَلَيۡكُمَا شُوَاظٞ مِّن نَّارٖ وَنُحَاسٞ فَلَا تَنتَصِرَانِ","textPlain":"يرسل عليكما شواظ من نار ونحاس فلا تنتصران","page":532},{"number":36,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","textPlain":"فباي ءالاء ربكما تكذبان","page":532},{"number":37,"text":"فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتۡ وَرۡدَةٗ كَٱلدِّهَانِ","textPlain":"فاذا انشقت السماء فكانت وردة كالدهان","page":532},{"number":38,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","textPlain":"فباي ءالاء ربكما تكذبان","page":532},{"number":39,"text":"فَيَوۡمَئِذٖ لَّا يُسۡـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٞ وَلَا جَآنّٞ","textPlain":"فيومئذ لا يسل عن ذنبه انس ولا جان","page":532},{"number":40,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","textPlain":"فباي ءالاء ربكما تكذبان","page":532},{"number":41,"text":"يُعۡرَفُ ٱلۡمُجۡرِمُونَ بِسِيمَٰهُمۡ فَيُؤۡخَذُ بِٱلنَّوَٰصِي وَٱلۡأَقۡدَامِ","textPlain":"يعرف المجرمون بسيمٰهم فيؤخذ بالنوٰصي والاقدام","page":532},{"number":42,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","textPlain":"فباي ءالاء ربكما تكذبان","page":533},{"number":43,"text":"هَٰذِهِۦ جَهَنَّمُ ٱلَّتِي يُكَذِّبُ بِهَا ٱلۡمُجۡرِمُونَ","textPlain":"هٰذه جهنم التي يكذب بها المجرمون","page":533},{"number":44,"text":"يَطُوفُونَ بَيۡنَهَا وَبَيۡنَ حَمِيمٍ ءَانٖ","textPlain":"يطوفون بينها وبين حميم ءان","page":533},{"number":45,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","textPlain":"فباي ءالاء ربكما تكذبان","page":533},{"number":46,"text":"وَلِمَنۡ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ","textPlain":"ولمن خاف مقام ربه جنتان","page":533},{"number":47,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","textPlain":"فباي ءالاء ربكما تكذبان","page":533},{"number":48,"text":"ذَوَاتَآ أَفۡنَانٖ","textPlain":"ذواتا افنان","page":533},{"number":49,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","textPlain":"فباي ءالاء ربكما تكذبان","p