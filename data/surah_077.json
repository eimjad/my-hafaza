[{"number":11,"text":"وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ","textPlain":"واذا الرسل اقتت","page":580},{"number":12,"text":"لِأَيِّ يَوۡمٍ أُجِّلَتۡ","textPlain":"لاي يوم اجلت","page":580},{"number":13,"text":"لِيَوۡمِ ٱلۡفَصۡلِ","textPlain":"ليوم الفصل","page":580},{"number":1,"text":"وَٱلۡمُرۡسَلَٰتِ عُرۡفٗا","textPlain":"والمرسلٰت عرفا","page":580},{"number":2,"text":"فَٱلۡعَٰصِفَٰتِ عَصۡفٗا","textPlain":"فالعٰصفٰت عصفا","page":580},{"number":3,"text":"وَٱلنَّٰشِرَٰتِ نَشۡرٗا","textPlain":"والنٰشرٰت نشرا","page":580},{"number":4,"text":"فَٱلۡفَٰرِقَٰتِ فَرۡقٗا","textPlain":"فالفٰرقٰت فرقا","page":580},{"number":5,"text":"فَٱلۡمُلۡقِيَٰتِ ذِكۡرًا","textPlain":"فالملقيٰت ذكرا","page":580},{"number":6,"text":"عُذۡرًا أَوۡ نُذۡرًا","textPlain":"عذرا او نذرا","page":580},{"number":7,"text":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٞ","textPlain":"انما توعدون لوٰقع","page":580},{"number":8,"text":"فَإِذَا ٱلنُّجُومُ طُمِسَتۡ","textPlain":"فاذا النجوم طمست","page":580},{"number":9,"text":"وَإِذَا ٱلسَّمَآءُ فُرِجَتۡ","textPlain":"واذا السماء فرجت","page":580},{"number":10,"text":"وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ","textPlain":"واذا الجبال نسفت","page":580},{"number":14,"text":"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلۡفَصۡلِ","textPlain":"وما ادرىٰك ما يوم الفصل","page":580},{"number":15,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","textPlain":"ويل يومئذ للمكذبين","page":580},{"number":16,"text":"أَلَمۡ نُهۡلِكِ ٱلۡأَوَّلِينَ","textPlain":"الم نهلك الاولين","page":580},{"number":17,"text":"ثُمَّ نُتۡبِعُهُمُ ٱلۡأٓخِرِينَ","textPlain":"ثم نتبعهم الاخرين","page":580},{"number":18,"text":"كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ","textPlain":"كذٰلك نفعل بالمجرمين","page":580},{"number":19,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","textPlain":"ويل يومئذ للمكذبين","page":580},{"number":20,"text":"أَلَمۡ نَخۡلُقكُّم مِّن مَّآءٖ مَّهِينٖ","textPlain":"الم نخلقكم من ماء مهين","page":581},{"number":21,"text":"فَجَعَلۡنَٰهُ فِي قَرَارٖ مَّكِينٍ","textPlain":"فجعلنٰه في قرار مكين","page":581},{"number":22,"text":"إِلَىٰ قَدَرٖ مَّعۡلُومٖ","textPlain":"الىٰ قدر معلوم","page":581},{"number":23,"text":"فَقَدَرۡنَا فَنِعۡمَ ٱلۡقَٰدِرُونَ","textPlain":"فقدرنا فنعم القٰدرون","page":581},{"number":24,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","textPlain":"ويل يومئذ للمكذبين","page":581},{"number":25,"text":"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ كِفَاتًا","textPlain":"الم نجعل الارض كفاتا","page":581},{"number":26,"text":"أَحۡيَآءٗ وَأَمۡوَٰتٗا","textPlain":"احياء واموٰتا","page":581},{"number":27,"text":"وَجَعَلۡنَا فِيهَا رَوَٰسِيَ شَٰمِخَٰتٖ وَأَسۡقَيۡنَٰكُم مَّآءٗ فُرَاتٗا","textPlain":"وجعلنا فيها روٰسي شٰمخٰت واسقينٰكم ماء فراتا","page":581},{"number":28,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","textPlain":"ويل يومئذ للمكذبين","page":581},{"number":29,"text":"ٱنطَلِقُوٓاْ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ","textPlain":"انطلقوا الىٰ ما كنتم به تكذبون","page":581},{"number":30,"text":"ٱنطَلِقُوٓاْ إِلَىٰ ظِلّٖ ذِي ثَلَٰثِ شُعَبٖ","textPlain":"انطلقوا الىٰ ظل ذي ثلٰث شعب","page":581},{"number":31,"text":"لَّا ظَلِيلٖ وَلَا يُغۡنِي مِنَ ٱللَّهَبِ","textPlain":"لا ظليل ولا يغني من اللهب","page":581},{"number":32,"text":"إِنَّهَا تَرۡمِي بِشَرَرٖ كَٱلۡقَصۡرِ","textPlain":"انها ترمي بشرر كالقصر","page":581},{"number":33,"text":"كَأَنَّهُۥ جِمَٰلَتٞ صُفۡرٞ","textPlain":"كانه جمٰلت صفر","page":581},{"number":34,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","textPlain":"ويل يومئذ للمكذبين","page":581},{"number":35,"text":"هَٰذَا يَوۡمُ لَا يَنطِقُونَ","textPlain":"هٰذا يوم لا ينطقون","page":581},{"number":36,"text":"وَلَا يُؤۡذَنُ لَهُمۡ فَيَعۡتَذِرُونَ","textPlain":"ولا يؤذن لهم فيعتذرون","page":581},{"number":37,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","textPlain":"ويل يومئذ للمكذبين","page":581},{"number":38,"text":"هَٰذَا يَوۡمُ ٱلۡفَصۡلِۖ جَمَعۡنَٰكُمۡ وَٱلۡأَوَّلِينَ","textPlain":"هٰذا يوم الفصل جمعنٰكم والاولين","page":581},{"number":39,"text":"فَإِن كَانَ لَكُمۡ كَيۡدٞ فَكِيدُونِ","textPlain":"فان كان لكم كيد فكيدون","page":581},{"number":40,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","textPlain":"ويل يومئذ للمكذبين","page":581},{"number":41,"text":"إِنَّ ٱلۡمُتَّقِينَ فِي ظِلَٰلٖ وَعُيُونٖ","textPlain":"ان المتقين في ظلٰل وعيون","page":581},{"number":42,"text":"وَفَوَٰكِهَ مِمَّا يَشۡتَهُونَ","textPlain":"وفوٰكه مما يشتهون","page":581},{"number":43,"text":"كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَا كُنتُمۡ تَعۡمَلُونَ","textPlain":"كلوا واشربوا هنيا بما كنتم تعملون","page":581},{"number":44,"text":"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","textPlain":"انا كذٰلك نجزي المحسنين","page":581},{"number":45,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","textPlain":"ويل يومئذ للمكذبين","page":581},{"number":46,"text":"كُلُواْ وَتَمَتَّعُواْ قَلِيلًا إِنَّكُم مُّجۡرِمُونَ","textPlain":"كلوا وتمتعوا قليلا انكم مجرمون","page":581},{"number":47,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","textPlain":"ويل يومئذ للمكذبين","page":581},{"number":48,"text":"وَإِذَا قِيلَ لَهُمُ ٱرۡكَعُواْ لَا يَرۡكَعُونَ","textPlain":"واذا قيل لهم اركعوا لا يركعون","page":581},{"number":49,"text":"وَيۡلٞ يَوۡمَئِذٖ لِّلۡمُكَذِّبِينَ","textPlain":"ويل يومئذ للمكذبين","page":581},{"number":50,"text":"فَبِأَيِّ حَدِيثِۭ بَعۡدَهُۥ يُؤۡمِنُونَ","textPlain":"فباي حديث بعده يؤمنون","page":581}]