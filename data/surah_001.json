[{"number":1,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ","textPlain":"بسم الله الرحمٰن الرحيم","page":1},{"number":2,"text":"ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ","textPlain":"الحمد لله رب العٰلمين","page":1},{"number":3,"text":"ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ","textPlain":"الرحمٰن الرحيم","page":1},{"number":4,"text":"مَٰلِكِ يَوۡمِ ٱلدِّينِ","textPlain":"مٰلك يوم الدين","page":1},{"number":5,"text":"إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ","textPlain":"اياك نعبد واياك نستعين","page":1},{"number":6,"text":"ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ","textPlain":"اهدنا الصرٰط المستقيم","page":1},{"number":7,"text":"صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ","textPlain":"صرٰط الذين انعمت عليهم غير المغضوب عليهم ولا الضالين","page":1}]