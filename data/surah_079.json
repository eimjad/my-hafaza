[{"number":1,"text":"وَٱلنَّٰزِعَٰتِ غَرۡقٗا","textPlain":"والنٰزعٰت غرقا","page":583},{"number":2,"text":"وَٱلنَّٰشِطَٰتِ نَشۡطٗا","textPlain":"والنٰشطٰت نشطا","page":583},{"number":3,"text":"وَٱلسَّٰبِحَٰتِ سَبۡحٗا","textPlain":"والسٰبحٰت سبحا","page":583},{"number":4,"text":"فَٱلسَّٰبِقَٰتِ سَبۡقٗا","textPlain":"فالسٰبقٰت سبقا","page":583},{"number":5,"text":"فَٱلۡمُدَبِّرَٰتِ أَمۡرٗا","textPlain":"فالمدبرٰت امرا","page":583},{"number":6,"text":"يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ","textPlain":"يوم ترجف الراجفة","page":583},{"number":7,"text":"تَتۡبَعُهَا ٱلرَّادِفَةُ","textPlain":"تتبعها الرادفة","page":583},{"number":8,"text":"قُلُوبٞ يَوۡمَئِذٖ وَاجِفَةٌ","textPlain":"قلوب يومئذ واجفة","page":583},{"number":9,"text":"أَبۡصَٰرُهَا خَٰشِعَةٞ","textPlain":"ابصٰرها خٰشعة","page":583},{"number":10,"text":"يَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ","textPlain":"يقولون اءنا لمردودون في الحافرة","page":583},{"number":11,"text":"أَءِذَا كُنَّا عِظَٰمٗا نَّخِرَةٗ","textPlain":"اءذا كنا عظٰما نخرة","page":583},{"number":12,"text":"قَالُواْ تِلۡكَ إِذٗا كَرَّةٌ خَاسِرَةٞ","textPlain":"قالوا تلك اذا كرة خاسرة","page":583},{"number":13,"text":"فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ","textPlain":"فانما هي زجرة وٰحدة","page":583},{"number":14,"text":"فَإِذَا هُم بِٱلسَّاهِرَةِ","textPlain":"فاذا هم بالساهرة","page":583},{"number":15,"text":"هَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","textPlain":"هل اتىٰك حديث موسىٰ","page":583},{"number":16,"text":"إِذۡ نَادَىٰهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى","textPlain":"اذ نادىٰه ربه بالواد المقدس طوى","page":583},{"number":17,"text":"ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ","textPlain":"اذهب الىٰ فرعون انه طغىٰ","page":584},{"number":18,"text":"فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","textPlain":"فقل هل لك الىٰ ان تزكىٰ","page":584},{"number":19,"text":"وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ","textPlain":"واهديك الىٰ ربك فتخشىٰ","page":584},{"number":20,"text":"فَأَرَىٰهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ","textPlain":"فارىٰه الاية الكبرىٰ","page":584},{"number":21,"text":"فَكَذَّبَ وَعَصَىٰ","textPlain":"فكذب وعصىٰ","page":584},{"number":22,"text":"ثُمَّ أَدۡبَرَ يَسۡعَىٰ","textPlain":"ثم ادبر يسعىٰ","page":584},{"number":23,"text":"فَحَشَرَ فَنَادَىٰ","textPlain":"فحشر فنادىٰ","page":584},{"number":24,"text":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ","textPlain":"فقال انا ربكم الاعلىٰ","page":584},{"number":25,"text":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰٓ","textPlain":"فاخذه الله نكال الاخرة والاولىٰ","page":584},{"number":26,"text":"إِنَّ فِي ذَٰلِكَ لَعِبۡرَةٗ لِّمَن يَخۡشَىٰٓ","textPlain":"ان في ذٰلك لعبرة لمن يخشىٰ","page":584},{"number":27,"text":"ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ بَنَىٰهَا","textPlain":"ءانتم اشد خلقا ام السماء بنىٰها","page":584},{"number":28,"text":"رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا","textPlain":"رفع سمكها فسوىٰها","page":584},{"number":29,"text":"وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا","textPlain":"واغطش ليلها واخرج ضحىٰها","page":584},{"number":30,"text":"وَٱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحَىٰهَآ","textPlain":"والارض بعد ذٰلك دحىٰها","page":584},{"number":31,"text":"أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعَىٰهَا","textPlain":"اخرج منها ماءها ومرعىٰها","page":584},{"number":32,"text":"وَٱلۡجِبَالَ أَرۡسَىٰهَا","textPlain":"والجبال ارسىٰها","page":584},{"number":33,"text":"مَتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ","textPlain":"متٰعا لكم ولانعٰمكم","page":584},{"number":34,"text":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ","textPlain":"فاذا جاءت الطامة الكبرىٰ","page":584},{"number":35,"text":"يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ","textPlain":"يوم يتذكر الانسٰن ما سعىٰ","page":584},{"number":36,"text":"وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىٰ","textPlain":"وبرزت الجحيم لمن يرىٰ","page":584},{"number":37,"text":"فَأَمَّا مَن طَغَىٰ","textPlain":"فاما من طغىٰ","page":584},{"number":38,"text":"وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","textPlain":"وءاثر الحيوٰة الدنيا","page":584},{"number":39,"text":"فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىٰ","textPlain":"فان الجحيم هي الماوىٰ","page":584},{"number":40,"text":"وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ","textPlain":"واما من خاف مقام ربه ونهى النفس عن الهوىٰ","page":584},{"number":41,"text":"فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىٰ","textPlain":"فان الجنة هي الماوىٰ","page":584},{"number":42,"text":"يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَا","textPlain":"يسلونك عن الساعة ايان مرسىٰها","page":584},{"number":43,"text":"فِيمَ أَنتَ مِن ذِكۡرَىٰهَآ","textPlain":"فيم انت من ذكرىٰها","page":584},{"number":44,"text":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","textPlain":"الىٰ ربك منتهىٰها","page":584},{"number":45,"text":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشَىٰهَا","textPlain":"انما انت منذر من يخشىٰها","page":584},{"number":46,"text":"كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحَىٰهَا","textPlain":"كانهم يوم يرونها لم يلبثوا الا عشية او ضحىٰها","page":584}]