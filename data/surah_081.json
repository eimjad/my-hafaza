[{"number":1,"text":"إِذَا ٱلشَّمۡسُ كُوِّرَتۡ","textPlain":"اذا الشمس كورت","page":586},{"number":2,"text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتۡ","textPlain":"واذا النجوم انكدرت","page":586},{"number":3,"text":"وَإِذَا ٱلۡجِبَالُ سُيِّرَتۡ","textPlain":"واذا الجبال سيرت","page":586},{"number":4,"text":"وَإِذَا ٱلۡعِشَارُ عُطِّلَتۡ","textPlain":"واذا العشار عطلت","page":586},{"number":5,"text":"وَإِذَا ٱلۡوُحُوشُ حُشِرَتۡ","textPlain":"واذا الوحوش حشرت","page":586},{"number":6,"text":"وَإِذَا ٱلۡبِحَارُ سُجِّرَتۡ","textPlain":"واذا البحار سجرت","page":586},{"number":7,"text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتۡ","textPlain":"واذا النفوس زوجت","page":586},{"number":8,"text":"وَإِذَا ٱلۡمَوۡءُۥدَةُ سُئِلَتۡ","textPlain":"واذا الموءدة سئلت","page":586},{"number":9,"text":"بِأَيِّ ذَنۢبٖ قُتِلَتۡ","textPlain":"باي ذنب قتلت","page":586},{"number":10,"text":"وَإِذَا ٱلصُّحُفُ نُشِرَتۡ","textPlain":"واذا الصحف نشرت","page":586},{"number":11,"text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتۡ","textPlain":"واذا السماء كشطت","page":586},{"number":12,"text":"وَإِذَا ٱلۡجَحِيمُ سُعِّرَتۡ","textPlain":"واذا الجحيم سعرت","page":586},{"number":13,"text":"وَإِذَا ٱلۡجَنَّةُ أُزۡلِفَتۡ","textPlain":"واذا الجنة ازلفت","page":586},{"number":14,"text":"عَلِمَتۡ نَفۡسٞ مَّآ أَحۡضَرَتۡ","textPlain":"علمت نفس ما احضرت","page":586},{"number":15,"text":"فَلَآ أُقۡسِمُ بِٱلۡخُنَّسِ","textPlain":"فلا اقسم بالخنس","page":586},{"number":16,"text":"ٱلۡجَوَارِ ٱلۡكُنَّسِ","textPlain":"الجوار الكنس","page":586},{"number":17,"text":"وَٱلَّيۡلِ إِذَا عَسۡعَسَ","textPlain":"واليل اذا عسعس","page":586},{"number":18,"text":"وَٱلصُّبۡحِ إِذَا تَنَفَّسَ","textPlain":"والصبح اذا تنفس","page":586},{"number":19,"text":"إِنَّهُۥ لَقَوۡلُ رَسُولٖ كَرِيمٖ","textPlain":"انه لقول رسول كريم","page":586},{"number":20,"text":"ذِي قُوَّةٍ عِندَ ذِي ٱلۡعَرۡشِ مَكِينٖ","textPlain":"ذي قوة عند ذي العرش مكين","page":586},{"number":21,"text":"مُّطَاعٖ ثَمَّ أَمِينٖ","textPlain":"مطاع ثم امين","page":586},{"number":22,"text":"وَمَا صَاحِبُكُم بِمَجۡنُونٖ","textPlain":"وما صاحبكم بمجنون","page":586},{"number":23,"text":"وَلَقَدۡ رَءَاهُ بِٱلۡأُفُقِ ٱلۡمُبِينِ","textPlain":"ولقد رءاه بالافق المبين","page":586},{"number":24,"text":"وَمَا هُوَ عَلَى ٱلۡغَيۡبِ بِضَنِينٖ","textPlain":"وما هو على الغيب بضنين","page":586},{"number":25,"text":"وَمَا هُوَ بِقَوۡلِ شَيۡطَٰنٖ رَّجِيمٖ","textPlain":"وما هو بقول شيطٰن رجيم","page":586},{"number":26,"text":"فَأَيۡنَ تَذۡهَبُونَ","textPlain":"فاين تذهبون","page":586},{"number":27,"text":"إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ","textPlain":"ان هو الا ذكر للعٰلمين","page":586},{"number":28,"text":"لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ","textPlain":"لمن شاء منكم ان يستقيم","page":586},{"number":29,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ","textPlain":"وما تشاءون الا ان يشاء الله رب العٰلمين","page":586}]