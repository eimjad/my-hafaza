[{"number":1,"text":"سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى","textPlain":"سبح اسم ربك الاعلى","page":591},{"number":2,"text":"ٱلَّذِي خَلَقَ فَسَوَّىٰ","textPlain":"الذي خلق فسوىٰ","page":591},{"number":3,"text":"وَٱلَّذِي قَدَّرَ فَهَدَىٰ","textPlain":"والذي قدر فهدىٰ","page":591},{"number":4,"text":"وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ","textPlain":"والذي اخرج المرعىٰ","page":591},{"number":5,"text":"فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ","textPlain":"فجعله غثاء احوىٰ","page":591},{"number":6,"text":"سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ","textPlain":"سنقرئك فلا تنسىٰ","page":591},{"number":7,"text":"إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ","textPlain":"الا ما شاء الله انه يعلم الجهر وما يخفىٰ","page":591},{"number":8,"text":"وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ","textPlain":"ونيسرك لليسرىٰ","page":591},{"number":9,"text":"فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ","textPlain":"فذكر ان نفعت الذكرىٰ","page":591},{"number":10,"text":"سَيَذَّكَّرُ مَن يَخۡشَىٰ","textPlain":"سيذكر من يخشىٰ","page":591},{"number":11,"text":"وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى","textPlain":"ويتجنبها الاشقى","page":592},{"number":12,"text":"ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ","textPlain":"الذي يصلى النار الكبرىٰ","page":592},{"number":13,"text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ","textPlain":"ثم لا يموت فيها ولا يحيىٰ","page":592},{"number":14,"text":"قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ","textPlain":"قد افلح من تزكىٰ","page":592},{"number":15,"text":"وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ","textPlain":"وذكر اسم ربه فصلىٰ","page":592},{"number":16,"text":"بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","textPlain":"بل تؤثرون الحيوٰة الدنيا","page":592},{"number":17,"text":"وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ","textPlain":"والاخرة خير وابقىٰ","page":592},{"number":18,"text":"إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ","textPlain":"ان هٰذا لفي الصحف الاولىٰ","page":592},{"number":19,"text":"صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ","textPlain":"صحف ابرٰهيم وموسىٰ","page":592}]