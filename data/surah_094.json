[{"number":1,"text":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ","textPlain":"الم نشرح لك صدرك","page":596},{"number":2,"text":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ","textPlain":"ووضعنا عنك وزرك","page":596},{"number":3,"text":"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ","textPlain":"الذي انقض ظهرك","page":597},{"number":4,"text":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ","textPlain":"ورفعنا لك ذكرك","page":597},{"number":5,"text":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا","textPlain":"فان مع العسر يسرا","page":597},{"number":6,"text":"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا","textPlain":"ان مع العسر يسرا","page":597},{"number":7,"text":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ","textPlain":"فاذا فرغت فانصب","page":597},{"number":8,"text":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب","textPlain":"والىٰ ربك فارغب","page":597}]