[{"number":1,"text":"قُلۡ يَٰٓأَيُّهَا ٱلۡكَٰفِرُونَ","textPlain":"قل يٰايها الكٰفرون","page":603},{"number":2,"text":"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ","textPlain":"لا اعبد ما تعبدون","page":603},{"number":3,"text":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","textPlain":"ولا انتم عٰبدون ما اعبد","page":603},{"number":4,"text":"وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ","textPlain":"ولا انا عابد ما عبدتم","page":603},{"number":5,"text":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","textPlain":"ولا انتم عٰبدون ما اعبد","page":603},{"number":6,"text":"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ","textPlain":"لكم دينكم ولي دين","page":603}]