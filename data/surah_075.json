[{"number":15,"text":"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ","textPlain":"ولو القىٰ معاذيره","page":577},{"number":1,"text":"لَآ أُقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ","textPlain":"لا اقسم بيوم القيٰمة","page":577},{"number":2,"text":"وَلَآ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ","textPlain":"ولا اقسم بالنفس اللوامة","page":577},{"number":3,"text":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ","textPlain":"ايحسب الانسٰن الن نجمع عظامه","page":577},{"number":4,"text":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ","textPlain":"بلىٰ قٰدرين علىٰ ان نسوي بنانه","page":577},{"number":5,"text":"بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ","textPlain":"بل يريد الانسٰن ليفجر امامه","page":577},{"number":6,"text":"يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ","textPlain":"يسل ايان يوم القيٰمة","page":577},{"number":7,"text":"فَإِذَا بَرِقَ ٱلۡبَصَرُ","textPlain":"فاذا برق البصر","page":577},{"number":8,"text":"وَخَسَفَ ٱلۡقَمَرُ","textPlain":"وخسف القمر","page":577},{"number":9,"text":"وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ","textPlain":"وجمع الشمس والقمر","page":577},{"number":10,"text":"يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ","textPlain":"يقول الانسٰن يومئذ اين المفر","page":577},{"number":11,"text":"كَلَّا لَا وَزَرَ","textPlain":"كلا لا وزر","page":577},{"number":12,"text":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ","textPlain":"الىٰ ربك يومئذ المستقر","page":577},{"number":13,"text":"يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ","textPlain":"ينبؤا الانسٰن يومئذ بما قدم واخر","page":577},{"number":14,"text":"بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةٞ","textPlain":"بل الانسٰن علىٰ نفسه بصيرة","page":577},{"number":16,"text":"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ","textPlain":"لا تحرك به لسانك لتعجل به","page":577},{"number":17,"text":"إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ","textPlain":"ان علينا جمعه وقرءانه","page":577},{"number":18,"text":"فَإِذَا قَرَأۡنَٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ","textPlain":"فاذا قرانٰه فاتبع قرءانه","page":577},{"number":19,"text":"ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ","textPlain":"ثم ان علينا بيانه","page":577},{"number":20,"text":"كَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ","textPlain":"كلا بل تحبون العاجلة","page":578},{"number":21,"text":"وَتَذَرُونَ ٱلۡأٓخِرَةَ","textPlain":"وتذرون الاخرة","page":578},{"number":22,"text":"وُجُوهٞ يَوۡمَئِذٖ نَّاضِرَةٌ","textPlain":"وجوه يومئذ ناضرة","page":578},{"number":23,"text":"إِلَىٰ رَبِّهَا نَاظِرَةٞ","textPlain":"الىٰ ربها ناظرة","page":578},{"number":24,"text":"وَوُجُوهٞ يَوۡمَئِذِۭ بَاسِرَةٞ","textPlain":"ووجوه يومئذ باسرة","page":578},{"number":25,"text":"تَظُنُّ أَن يُفۡعَلَ بِهَا فَاقِرَةٞ","textPlain":"تظن ان يفعل بها فاقرة","page":578},{"number":26,"text":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِيَ","textPlain":"كلا اذا بلغت التراقي","page":578},{"number":27,"text":"وَقِيلَ مَنۡۜ رَاقٖ","textPlain":"وقيل من راق","page":578},{"number":28,"text":"وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ","textPlain":"وظن انه الفراق","page":578},{"number":29,"text":"وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","textPlain":"والتفت الساق بالساق","page":578},{"number":30,"text":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمَسَاقُ","textPlain":"الىٰ ربك يومئذ المساق","page":578},{"number":31,"text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","textPlain":"فلا صدق ولا صلىٰ","page":578},{"number":32,"text":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ","textPlain":"ولٰكن كذب وتولىٰ","page":578},{"number":33,"text":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهۡلِهِۦ يَتَمَطَّىٰٓ","textPlain":"ثم ذهب الىٰ اهله يتمطىٰ","page":578},{"number":34,"text":"أَوۡلَىٰ لَكَ فَأَوۡلَىٰ","textPlain":"اولىٰ لك فاولىٰ","page":578},{"number":35,"text":"ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰٓ","textPlain":"ثم اولىٰ لك فاولىٰ","page":578},{"number":36,"text":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى","textPlain":"ايحسب الانسٰن ان يترك سدى","page":578},{"number":37,"text":"أَلَمۡ يَكُ نُطۡفَةٗ مِّن مَّنِيّٖ يُمۡنَىٰ","textPlain":"الم يك نطفة من مني يمنىٰ","page":578},{"number":38,"text":"ثُمَّ كَانَ عَلَقَةٗ فَخَلَقَ فَسَوَّىٰ","textPlain":"ثم كان علقة فخلق فسوىٰ","page":578},{"number":39,"text":"فَجَعَلَ مِنۡهُ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ","textPlain":"فجعل منه الزوجين الذكر والانثىٰ","page":578},{"number":40,"text":"أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰ","textPlain":"اليس ذٰلك بقٰدر علىٰ ان يحي الموتىٰ","page":578}]