[{"number":15,"text":"لِّنُخۡرِجَ بِهِۦ حَبّٗا وَنَبَاتٗا","textPlain":"لنخرج به حبا ونباتا","page":582},{"number":16,"text":"وَجَنَّٰتٍ أَلۡفَافًا","textPlain":"وجنٰت الفافا","page":582},{"number":1,"text":"عَمَّ يَتَسَآءَلُونَ","textPlain":"عم يتساءلون","page":582},{"number":2,"text":"عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ","textPlain":"عن النبا العظيم","page":582},{"number":3,"text":"ٱلَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ","textPlain":"الذي هم فيه مختلفون","page":582},{"number":4,"text":"كَلَّا سَيَعۡلَمُونَ","textPlain":"كلا سيعلمون","page":582},{"number":5,"text":"ثُمَّ كَلَّا سَيَعۡلَمُونَ","textPlain":"ثم كلا سيعلمون","page":582},{"number":6,"text":"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدٗا","textPlain":"الم نجعل الارض مهٰدا","page":582},{"number":7,"text":"وَٱلۡجِبَالَ أَوۡتَادٗا","textPlain":"والجبال اوتادا","page":582},{"number":8,"text":"وَخَلَقۡنَٰكُمۡ أَزۡوَٰجٗا","textPlain":"وخلقنٰكم ازوٰجا","page":582},{"number":9,"text":"وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتٗا","textPlain":"وجعلنا نومكم سباتا","page":582},{"number":10,"text":"وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسٗا","textPlain":"وجعلنا اليل لباسا","page":582},{"number":11,"text":"وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشٗا","textPlain":"وجعلنا النهار معاشا","page":582},{"number":12,"text":"وَبَنَيۡنَا فَوۡقَكُمۡ سَبۡعٗا شِدَادٗا","textPlain":"وبنينا فوقكم سبعا شدادا","page":582},{"number":13,"text":"وَجَعَلۡنَا سِرَاجٗا وَهَّاجٗا","textPlain":"وجعلنا سراجا وهاجا","page":582},{"number":14,"text":"وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءٗ ثَجَّاجٗا","textPlain":"وانزلنا من المعصرٰت ماء ثجاجا","page":582},{"number":17,"text":"إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتٗا","textPlain":"ان يوم الفصل كان ميقٰتا","page":582},{"number":18,"text":"يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجٗا","textPlain":"يوم ينفخ في الصور فتاتون افواجا","page":582},{"number":19,"text":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبٗا","textPlain":"وفتحت السماء فكانت ابوٰبا","page":582},{"number":20,"text":"وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا","textPlain":"وسيرت الجبال فكانت سرابا","page":582},{"number":21,"text":"إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادٗا","textPlain":"ان جهنم كانت مرصادا","page":582},{"number":22,"text":"لِّلطَّٰغِينَ مَـَٔابٗا","textPlain":"للطٰغين مابا","page":582},{"number":23,"text":"لَّٰبِثِينَ فِيهَآ أَحۡقَابٗا","textPlain":"لٰبثين فيها احقابا","page":582},{"number":24,"text":"لَّا يَذُوقُونَ فِيهَا بَرۡدٗا وَلَا شَرَابًا","textPlain":"لا يذوقون فيها بردا ولا شرابا","page":582},{"number":25,"text":"إِلَّا حَمِيمٗا وَغَسَّاقٗا","textPlain":"الا حميما وغساقا","page":582},{"number":26,"text":"جَزَآءٗ وِفَاقًا","textPlain":"جزاء وفاقا","page":582},{"number":27,"text":"إِنَّهُمۡ كَانُواْ لَا يَرۡجُونَ حِسَابٗا","textPlain":"انهم كانوا لا يرجون حسابا","page":582},{"number":28,"text":"وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابٗا","textPlain":"وكذبوا بايٰتنا كذابا","page":582},{"number":29,"text":"وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ كِتَٰبٗا","textPlain":"وكل شيء احصينٰه كتٰبا","page":582},{"number":30,"text":"فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا","textPlain":"فذوقوا فلن نزيدكم الا عذابا","page":582},{"number":31,"text":"إِنَّ لِلۡمُتَّقِينَ مَفَازًا","textPlain":"ان للمتقين مفازا","page":583},{"number":32,"text":"حَدَآئِقَ وَأَعۡنَٰبٗا","textPlain":"حدائق واعنٰبا","page":583},{"number":33,"text":"وَكَوَاعِبَ أَتۡرَابٗا","textPlain":"وكواعب اترابا","page":583},{"number":34,"text":"وَكَأۡسٗا دِهَاقٗا","textPlain":"وكاسا دهاقا","page":583},{"number":35,"text":"لَّا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا كِذَّٰبٗا","textPlain":"لا يسمعون فيها لغوا ولا كذٰبا","page":583},{"number":36,"text":"جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَابٗا","textPlain":"جزاء من ربك عطاء حسابا","page":583},{"number":37,"text":"رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا","textPlain":"رب السمٰوٰت والارض وما بينهما الرحمٰن لا يملكون منه خطابا","page":583},{"number":38,"text":"يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَٰٓئِكَةُ صَفّٗاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابٗا","textPlain":"يوم يقوم الروح والملٰئكة صفا لا يتكلمون الا من اذن له الرحمٰن وقال صوابا","page":583},{"number":39,"text":"ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","textPlain":"ذٰلك اليوم الحق فمن شاء اتخذ الىٰ ربه مابا","page":583},{"number":40,"text":"إِنَّآ أَنذَرۡنَٰكُمۡ عَذَابٗا قَرِيبٗا يَوۡمَ يَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُ وَيَقُولُ ٱلۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا","textPlain":"انا انذرنٰكم عذابا قريبا يوم ينظر المرء ما قدمت يداه ويقول الكافر يٰليتني كنت ترٰبا","page":583}]