[{"number":1,"text":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ","textPlain":"اقرا باسم ربك الذي خلق","page":597},{"number":2,"text":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ","textPlain":"خلق الانسٰن من علق","page":597},{"number":3,"text":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ","textPlain":"اقرا وربك الاكرم","page":597},{"number":4,"text":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ","textPlain":"الذي علم بالقلم","page":597},{"number":5,"text":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ","textPlain":"علم الانسٰن ما لم يعلم","page":597},{"number":6,"text":"كَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ","textPlain":"كلا ان الانسٰن ليطغىٰ","page":597},{"number":7,"text":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ","textPlain":"ان رءاه استغنىٰ","page":597},{"number":8,"text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ","textPlain":"ان الىٰ ربك الرجعىٰ","page":597},{"number":9,"text":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ","textPlain":"ارءيت الذي ينهىٰ","page":597},{"number":10,"text":"عَبۡدًا إِذَا صَلَّىٰٓ","textPlain":"عبدا اذا صلىٰ","page":597},{"number":11,"text":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ","textPlain":"ارءيت ان كان على الهدىٰ","page":597},{"number":12,"text":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ","textPlain":"او امر بالتقوىٰ","page":597},{"number":13,"text":"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","textPlain":"ارءيت ان كذب وتولىٰ","page":598},{"number":14,"text":"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ","textPlain":"الم يعلم بان الله يرىٰ","page":598},{"number":15,"text":"كَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ","textPlain":"كلا لئن لم ينته لنسفعا بالناصية","page":598},{"number":16,"text":"نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖ","textPlain":"ناصية كٰذبة خاطئة","page":598},{"number":17,"text":"فَلۡيَدۡعُ نَادِيَهُۥ","textPlain":"فليدع ناديه","page":598},{"number":18,"text":"سَنَدۡعُ ٱلزَّبَانِيَةَ","textPlain":"سندع الزبانية","page":598},{"number":19,"text":"كَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩","textPlain":"كلا لا تطعه واسجد واقترب","page":598}]