[{"number":10,"text":"فِي جَنَّةٍ عَالِيَةٖ","textPlain":"في جنة عالية","page":592},{"number":1,"text":"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ","textPlain":"هل اتىٰك حديث الغٰشية","page":592},{"number":2,"text":"وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ","textPlain":"وجوه يومئذ خٰشعة","page":592},{"number":3,"text":"عَامِلَةٞ نَّاصِبَةٞ","textPlain":"عاملة ناصبة","page":592},{"number":4,"text":"تَصۡلَىٰ نَارًا حَامِيَةٗ","textPlain":"تصلىٰ نارا حامية","page":592},{"number":5,"text":"تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ","textPlain":"تسقىٰ من عين ءانية","page":592},{"number":6,"text":"لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ","textPlain":"ليس لهم طعام الا من ضريع","page":592},{"number":7,"text":"لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ","textPlain":"لا يسمن ولا يغني من جوع","page":592},{"number":8,"text":"وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ","textPlain":"وجوه يومئذ ناعمة","page":592},{"number":9,"text":"لِّسَعۡيِهَا رَاضِيَةٞ","textPlain":"لسعيها راضية","page":592},{"number":11,"text":"لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ","textPlain":"لا تسمع فيها لٰغية","page":592},{"number":12,"text":"فِيهَا عَيۡنٞ جَارِيَةٞ","textPlain":"فيها عين جارية","page":592},{"number":13,"text":"فِيهَا سُرُرٞ مَّرۡفُوعَةٞ","textPlain":"فيها سرر مرفوعة","page":592},{"number":14,"text":"وَأَكۡوَابٞ مَّوۡضُوعَةٞ","textPlain":"واكواب موضوعة","page":592},{"number":15,"text":"وَنَمَارِقُ مَصۡفُوفَةٞ","textPlain":"ونمارق مصفوفة","page":592},{"number":16,"text":"وَزَرَابِيُّ مَبۡثُوثَةٌ","textPlain":"وزرابي مبثوثة","page":592},{"number":17,"text":"أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ","textPlain":"افلا ينظرون الى الابل كيف خلقت","page":592},{"number":18,"text":"وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ","textPlain":"والى السماء كيف رفعت","page":592},{"number":19,"text":"وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ","textPlain":"والى الجبال كيف نصبت","page":592},{"number":20,"text":"وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ","textPlain":"والى الارض كيف سطحت","page":592},{"number":21,"text":"فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ","textPlain":"فذكر انما انت مذكر","page":592},{"number":22,"text":"لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ","textPlain":"لست عليهم بمصيطر","page":592},{"number":23,"text":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","textPlain":"الا من تولىٰ وكفر","page":593},{"number":24,"text":"فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ","textPlain":"فيعذبه الله العذاب الاكبر","page":593},{"number":25,"text":"إِنَّ إِلَيۡنَآ إِيَابَهُمۡ","textPlain":"ان الينا ايابهم","page":593},{"number":26,"text":"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم","textPlain":"ثم ان علينا حسابهم","page":593}]