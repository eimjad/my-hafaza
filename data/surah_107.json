[{"number":1,"text":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","textPlain":"ارءيت الذي يكذب بالدين","page":602},{"number":2,"text":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","textPlain":"فذٰلك الذي يدع اليتيم","page":602},{"number":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","textPlain":"ولا يحض علىٰ طعام المسكين","page":602},{"number":4,"text":"فَوَيۡلٞ لِّلۡمُصَلِّينَ","textPlain":"فويل للمصلين","page":602},{"number":5,"text":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","textPlain":"الذين هم عن صلاتهم ساهون","page":602},{"number":6,"text":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","textPlain":"الذين هم يراءون","page":602},{"number":7,"text":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","textPlain":"ويمنعون الماعون","page":602}]