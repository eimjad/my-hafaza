[{"number":5,"text":"أَمَّا مَنِ ٱسۡتَغۡنَىٰ","textPlain":"اما من استغنىٰ","page":585},{"number":6,"text":"فَأَنتَ لَهُۥ تَصَدَّىٰ","textPlain":"فانت له تصدىٰ","page":585},{"number":7,"text":"وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ","textPlain":"وما عليك الا يزكىٰ","page":585},{"number":8,"text":"وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ","textPlain":"واما من جاءك يسعىٰ","page":585},{"number":9,"text":"وَهُوَ يَخۡشَىٰ","textPlain":"وهو يخشىٰ","page":585},{"number":10,"text":"فَأَنتَ عَنۡهُ تَلَهَّىٰ","textPlain":"فانت عنه تلهىٰ","page":585},{"number":11,"text":"كَلَّآ إِنَّهَا تَذۡكِرَةٞ","textPlain":"كلا انها تذكرة","page":585},{"number":12,"text":"فَمَن شَآءَ ذَكَرَهُۥ","textPlain":"فمن شاء ذكره","page":585},{"number":13,"text":"فِي صُحُفٖ مُّكَرَّمَةٖ","textPlain":"في صحف مكرمة","page":585},{"number":14,"text":"مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ","textPlain":"مرفوعة مطهرة","page":585},{"number":15,"text":"بِأَيۡدِي سَفَرَةٖ","textPlain":"بايدي سفرة","page":585},{"number":16,"text":"كِرَامِۭ بَرَرَةٖ","textPlain":"كرام بررة","page":585},{"number":17,"text":"قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ","textPlain":"قتل الانسٰن ما اكفره","page":585},{"number":18,"text":"مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ","textPlain":"من اي شيء خلقه","page":585},{"number":19,"text":"مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","textPlain":"من نطفة خلقه فقدره","page":585},{"number":20,"text":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","textPlain":"ثم السبيل يسره","page":585},{"number":1,"text":"عَبَسَ وَتَوَلَّىٰٓ","textPlain":"عبس وتولىٰ","page":585},{"number":2,"text":"أَن جَآءَهُ ٱلۡأَعۡمَىٰ","textPlain":"ان جاءه الاعمىٰ","page":585},{"number":3,"text":"وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","textPlain":"وما يدريك لعله يزكىٰ","page":585},{"number":4,"text":"أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ","textPlain":"او يذكر فتنفعه الذكرىٰ","page":585},{"number":21,"text":"ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ","textPlain":"ثم اماته فاقبره","page":585},{"number":22,"text":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","textPlain":"ثم اذا شاء انشره","page":585},{"number":23,"text":"كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ","textPlain":"كلا لما يقض ما امره","page":585},{"number":24,"text":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","textPlain":"فلينظر الانسٰن الىٰ طعامه","page":585},{"number":25,"text":"أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا","textPlain":"انا صببنا الماء صبا","page":585},{"number":26,"text":"ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا","textPlain":"ثم شققنا الارض شقا","page":585},{"number":27,"text":"فَأَنۢبَتۡنَا فِيهَا حَبّٗا","textPlain":"فانبتنا فيها حبا","page":585},{"number":28,"text":"وَعِنَبٗا وَقَضۡبٗا","textPlain":"وعنبا وقضبا","page":585},{"number":29,"text":"وَزَيۡتُونٗا وَنَخۡلٗا","textPlain":"وزيتونا ونخلا","page":585},{"number":30,"text":"وَحَدَآئِقَ غُلۡبٗا","textPlain":"وحدائق غلبا","page":585},{"number":31,"text":"وَفَٰكِهَةٗ وَأَبّٗا","textPlain":"وفٰكهة وابا","page":585},{"number":32,"text":"مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ","textPlain":"متٰعا لكم ولانعٰمكم","page":585},{"number":33,"text":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","textPlain":"فاذا جاءت الصاخة","page":585},{"number":34,"text":"يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ","textPlain":"يوم يفر المرء من اخيه","page":585},{"number":35,"text":"وَأُمِّهِۦ وَأَبِيهِ","textPlain":"وامه وابيه","page":585},{"number":36,"text":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","textPlain":"وصٰحبته وبنيه","page":585},{"number":37,"text":"لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ","textPlain":"لكل امري منهم يومئذ شان يغنيه","page":585},{"number":38,"text":"وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ","textPlain":"وجوه يومئذ مسفرة","page":585},{"number":39,"text":"ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ","textPlain":"ضاحكة مستبشرة","page":585},{"number":40,"text":"وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ","textPlain":"ووجوه يومئذ عليها غبرة","page":585},{"number":41,"text":"تَرۡهَقُهَا قَتَرَةٌ","textPlain":"ترهقها قترة","page":586},{"number":42,"text":"أُوْلَٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ","textPlain":"اولٰئك هم الكفرة الفجرة","page":586}]