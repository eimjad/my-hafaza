[{"number":1,"text":"قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ","textPlain":"قل اعوذ برب الفلق","page":604},{"number":2,"text":"مِن شَرِّ مَا خَلَقَ","textPlain":"من شر ما خلق","page":604},{"number":3,"text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","textPlain":"ومن شر غاسق اذا وقب","page":604},{"number":4,"text":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِي ٱلۡعُقَدِ","textPlain":"ومن شر النفٰثٰت في العقد","page":604},{"number":5,"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","textPlain":"ومن شر حاسد اذا حسد","page":604}]