[{"number":11,"text":"نَارٌ حَامِيَةُۢ","textPlain":"نار حامية","page":600},{"number":10,"text":"وَمَآ أَدۡرَىٰكَ مَا هِيَهۡ","textPlain":"وما ادرىٰك ما هيه","page":600},{"number":1,"text":"ٱلۡقَارِعَةُ","textPlain":"القارعة","page":600},{"number":2,"text":"مَا ٱلۡقَارِعَةُ","textPlain":"ما القارعة","page":600},{"number":3,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡقَارِعَةُ","textPlain":"وما ادرىٰك ما القارعة","page":600},{"number":4,"text":"يَوۡمَ يَكُونُ ٱلنَّاسُ كَٱلۡفَرَاشِ ٱلۡمَبۡثُوثِ","textPlain":"يوم يكون الناس كالفراش المبثوث","page":600},{"number":5,"text":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ ٱلۡمَنفُوشِ","textPlain":"وتكون الجبال كالعهن المنفوش","page":600},{"number":6,"text":"فَأَمَّا مَن ثَقُلَتۡ مَوَٰزِينُهُۥ","textPlain":"فاما من ثقلت موٰزينه","page":600},{"number":7,"text":"فَهُوَ فِي عِيشَةٖ رَّاضِيَةٖ","textPlain":"فهو في عيشة راضية","page":600},{"number":8,"text":"وَأَمَّا مَنۡ خَفَّتۡ مَوَٰزِينُهُۥ","textPlain":"واما من خفت موٰزينه","page":600},{"number":9,"text":"فَأُمُّهُۥ هَاوِيَةٞ","textPlain":"فامه هاوية","page":600}]