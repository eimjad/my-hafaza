[{"number":4,"text":"إِنَّ إِلَٰهَكُمۡ لَوَٰحِدٞ","textPlain":"ان الٰهكم لوٰحد","page":446},{"number":52,"text":"يَقُولُ أَءِنَّكَ لَمِنَ ٱلۡمُصَدِّقِينَ","textPlain":"يقول اءنك لمن المصدقين","page":448},{"number":77,"text":"وَجَعَلۡنَا ذُرِّيَّتَهُۥ هُمُ ٱلۡبَاقِينَ","textPlain":"وجعلنا ذريته هم الباقين","page":449},{"number":3,"text":"فَٱلتَّٰلِيَٰتِ ذِكۡرًا","textPlain":"فالتٰليٰت ذكرا","page":446},{"number":1,"text":"وَٱلصَّٰٓفَّٰتِ صَفّٗا","textPlain":"والصٰفٰت صفا","page":446},{"number":2,"text":"فَٱلزَّٰجِرَٰتِ زَجۡرٗا","textPlain":"فالزٰجرٰت زجرا","page":446},{"number":5,"text":"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا وَرَبُّ ٱلۡمَشَٰرِقِ","textPlain":"رب السمٰوٰت والارض وما بينهما ورب المشٰرق","page":446},{"number":6,"text":"إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنۡيَا بِزِينَةٍ ٱلۡكَوَاكِبِ","textPlain":"انا زينا السماء الدنيا بزينة الكواكب","page":446},{"number":7,"text":"وَحِفۡظٗا مِّن كُلِّ شَيۡطَٰنٖ مَّارِدٖ","textPlain":"وحفظا من كل شيطٰن مارد","page":446},{"number":8,"text":"لَّا يَسَّمَّعُونَ إِلَى ٱلۡمَلَإِ ٱلۡأَعۡلَىٰ وَيُقۡذَفُونَ مِن كُلِّ جَانِبٖ","textPlain":"لا يسمعون الى الملا الاعلىٰ ويقذفون من كل جانب","page":446},{"number":9,"text":"دُحُورٗاۖ وَلَهُمۡ عَذَابٞ وَاصِبٌ","textPlain":"دحورا ولهم عذاب واصب","page":446},{"number":10,"text":"إِلَّا مَنۡ خَطِفَ ٱلۡخَطۡفَةَ فَأَتۡبَعَهُۥ شِهَابٞ ثَاقِبٞ","textPlain":"الا من خطف الخطفة فاتبعه شهاب ثاقب","page":446},{"number":11,"text":"فَٱسۡتَفۡتِهِمۡ أَهُمۡ أَشَدُّ خَلۡقًا أَم مَّنۡ خَلَقۡنَآۚ إِنَّا خَلَقۡنَٰهُم مِّن طِينٖ لَّازِبِۭ","textPlain":"فاستفتهم اهم اشد خلقا ام من خلقنا انا خلقنٰهم من طين لازب","page":446},{"number":12,"text":"بَلۡ عَجِبۡتَ وَيَسۡخَرُونَ","textPlain":"بل عجبت ويسخرون","page":446},{"number":13,"text":"وَإِذَا ذُكِّرُواْ لَا يَذۡكُرُونَ","textPlain":"واذا ذكروا لا يذكرون","page":446},{"number":14,"text":"وَإِذَا رَأَوۡاْ ءَايَةٗ يَسۡتَسۡخِرُونَ","textPlain":"واذا راوا ءاية يستسخرون","page":446},{"number":15,"text":"وَقَالُوٓاْ إِنۡ هَٰذَآ إِلَّا سِحۡرٞ مُّبِينٌ","textPlain":"وقالوا ان هٰذا الا سحر مبين","page":446},{"number":16,"text":"أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ","textPlain":"اءذا متنا وكنا ترابا وعظٰما اءنا لمبعوثون","page":446},{"number":17,"text":"أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ","textPlain":"اوءاباؤنا الاولون","page":446},{"number":18,"text":"قُلۡ نَعَمۡ وَأَنتُمۡ دَٰخِرُونَ","textPlain":"قل نعم وانتم دٰخرون","page":446},{"number":19,"text":"فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ فَإِذَا هُمۡ يَنظُرُونَ","textPlain":"فانما هي زجرة وٰحدة فاذا هم ينظرون","page":446},{"number":20,"text":"وَقَالُواْ يَٰوَيۡلَنَا هَٰذَا يَوۡمُ ٱلدِّينِ","textPlain":"وقالوا يٰويلنا هٰذا يوم الدين","page":446},{"number":21,"text":"هَٰذَا يَوۡمُ ٱلۡفَصۡلِ ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ","textPlain":"هٰذا يوم الفصل الذي كنتم به تكذبون","page":446},{"number":22,"text":"۞ٱحۡشُرُواْ ٱلَّذِينَ ظَلَمُواْ وَأَزۡوَٰجَهُمۡ وَمَا كَانُواْ يَعۡبُدُونَ","textPlain":"احشروا الذين ظلموا وازوٰجهم وما كانوا يعبدون","page":446},{"number":23,"text":"مِن دُونِ ٱللَّهِ فَٱهۡدُوهُمۡ إِلَىٰ صِرَٰطِ ٱلۡجَحِيمِ","textPlain":"من دون الله فاهدوهم الىٰ صرٰط الجحيم","page":446},{"number":24,"text":"وَقِفُوهُمۡۖ إِنَّهُم مَّسۡـُٔولُونَ","textPlain":"وقفوهم انهم مسولون","page":446},{"number":25,"text":"مَا لَكُمۡ لَا تَنَاصَرُونَ","textPlain":"ما لكم لا تناصرون","page":447},{"number":26,"text":"بَلۡ هُمُ ٱلۡيَوۡمَ مُسۡتَسۡلِمُونَ","textPlain":"بل هم اليوم مستسلمون","page":447},{"number":27,"text":"وَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ","textPlain":"واقبل بعضهم علىٰ بعض يتساءلون","page":447},{"number":28,"text":"قَالُوٓاْ إِنَّكُمۡ كُنتُمۡ تَأۡتُونَنَا عَنِ ٱلۡيَمِينِ","textPlain":"قالوا انكم كنتم تاتوننا عن اليمين","page":447},{"number":29,"text":"قَالُواْ بَل لَّمۡ تَكُونُواْ مُؤۡمِنِينَ","textPlain":"قالوا بل لم تكونوا مؤمنين","page":447},{"number":30,"text":"وَمَا كَانَ لَنَا عَلَيۡكُم مِّن سُلۡطَٰنِۭۖ بَلۡ كُنتُمۡ قَوۡمٗا طَٰغِينَ","textPlain":"وما كان لنا عليكم من سلطٰن بل كنتم قوما طٰغين","page":447},{"number":31,"text":"فَحَقَّ عَلَيۡنَا قَوۡلُ رَبِّنَآۖ إِنَّا لَذَآئِقُونَ","textPlain":"فحق علينا قول ربنا انا لذائقون","page":447},{"number":32,"text":"فَأَغۡوَيۡنَٰكُمۡ إِنَّا كُنَّا غَٰوِينَ","textPlain":"فاغوينٰكم انا كنا غٰوين","page":447},{"number":33,"text":"فَإِنَّهُمۡ يَوۡمَئِذٖ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ","textPlain":"فانهم يومئذ في العذاب مشتركون","page":447},{"number":34,"text":"إِنَّا كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ","textPlain":"انا كذٰلك نفعل بالمجرمين","page":447},{"number":35,"text":"إِنَّهُمۡ كَانُوٓاْ إِذَا قِيلَ لَهُمۡ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسۡتَكۡبِرُونَ","textPlain":"انهم كانوا اذا قيل لهم لا الٰه الا الله يستكبرون","page":447},{"number":36,"text":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرٖ مَّجۡنُونِۭ","textPlain":"ويقولون ائنا لتاركوا ءالهتنا لشاعر مجنون","page":447},{"number":37,"text":"بَلۡ جَآءَ بِٱلۡحَقِّ وَصَدَّقَ ٱلۡمُرۡسَلِينَ","textPlain":"بل جاء بالحق وصدق المرسلين","page":447},{"number":38,"text":"إِنَّكُمۡ لَذَآئِقُواْ ٱلۡعَذَابِ ٱلۡأَلِيمِ","textPlain":"انكم لذائقوا العذاب الاليم","page":447},{"number":39,"text":"وَمَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ","textPlain":"وما تجزون الا ما كنتم تعملون","page":447},{"number":40,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ","textPlain":"الا عباد الله المخلصين","page":447},{"number":41,"text":"أُوْلَٰٓئِكَ لَهُمۡ رِزۡقٞ مَّعۡلُومٞ","textPlain":"اولٰئك لهم رزق معلوم","page":447},{"number":42,"text":"فَوَٰكِهُ وَهُم مُّكۡرَمُونَ","textPlain":"فوٰكه وهم مكرمون","page":447},{"number":43,"text":"فِي جَنَّٰتِ ٱلنَّعِيمِ","textPlain":"في جنٰت النعيم","page":447},{"number":44,"text":"عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَ","textPlain":"علىٰ سرر متقٰبلين","page":447},{"number":45,"text":"يُطَافُ عَلَيۡهِم بِكَأۡسٖ مِّن مَّعِينِۭ","textPlain":"يطاف عليهم بكاس من معين","page":447},{"number":46,"text":"بَيۡضَآءَ لَذَّةٖ لِّلشَّٰرِبِينَ","textPlain":"بيضاء لذة للشٰربين","page":447},{"number":47,"text":"لَا فِيهَا غَوۡلٞ وَلَا هُمۡ عَنۡهَا يُنزَفُونَ","textPlain":"لا فيها غول ولا هم عنها ينزفون","page":447},{"number":48,"text":"وَعِندَهُمۡ قَٰصِرَٰتُ ٱلطَّرۡفِ عِينٞ","textPlain":"وعندهم قٰصرٰت الطرف عين","page":447},{"number":49,"text":"كَأَنَّهُنَّ بَيۡضٞ مَّكۡنُونٞ","textPlain":"كانهن بيض مكنون","page":447},{"number":50,"text":"فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ","textPlain":"فاقبل بعضهم علىٰ بعض يتساءلون","page":447},{"number":51,"text":"قَالَ قَآئِلٞ مِّنۡهُمۡ إِنِّي كَانَ لِي قَرِينٞ","textPlain":"قال قائل منهم اني كان لي قرين","page":447},{"number":53,"text":"أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ","textPlain":"اءذا متنا وكنا ترابا وعظٰما اءنا لمدينون","page":448},{"number":54,"text":"قَالَ هَلۡ أَنتُم مُّطَّلِعُونَ","textPlain":"قال هل انتم مطلعون","page":448},{"number":55,"text":"فَٱطَّلَعَ فَرَءَاهُ فِي سَوَآءِ ٱلۡجَحِيمِ","textPlain":"فاطلع فرءاه في سواء الجحيم","page":448},{"number":56,"text":"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرۡدِينِ","textPlain":"قال تالله ان كدت لتردين","page":448},{"number":57,"text":"وَلَوۡلَا نِعۡمَةُ رَبِّي لَكُنتُ مِنَ ٱلۡمُحۡضَرِينَ","textPlain":"ولولا نعمة ربي لكنت من المحضرين","page":448},{"number":58,"text":"أَفَمَا نَحۡنُ بِمَيِّتِينَ","textPlain":"افما نحن بميتين","page":448},{"number":59,"text":"إِلَّا مَوۡتَتَنَا ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُعَذَّبِينَ","textPlain":"الا موتتنا الاولىٰ وما نحن بمعذبين","page":448},{"number":60,"text":"إِنَّ هَٰذَا لَهُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ","textPlain":"ان هٰذا لهو الفوز العظيم","page":448},{"number":61,"text":"لِمِثۡلِ هَٰذَا فَلۡيَعۡمَلِ ٱلۡعَٰمِلُونَ","textPlain":"لمثل هٰذا فليعمل العٰملون","page":448},{"number":62,"text":"أَذَٰلِكَ خَيۡرٞ نُّزُلًا أَمۡ شَجَرَةُ ٱلزَّقُّومِ","textPlain":"اذٰلك خير نزلا ام شجرة الزقوم","page":448},{"number":63,"text":"إِنَّا جَعَلۡنَٰهَا فِتۡنَةٗ لِّلظَّٰلِمِينَ","textPlain":"انا جعلنٰها فتنة للظٰلمين","page":448},{"number":64,"text":"إِنَّهَا شَجَرَةٞ تَخۡرُجُ فِيٓ أَصۡلِ ٱلۡجَحِيمِ","textPlain":"انها شجرة تخرج في اصل الجحيم","page":448},{"number":65,"text":"طَلۡعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ","textPlain":"طلعها كانه رءوس الشيٰطين","page":448},{"number":66,"text":"فَإِنَّهُمۡ لَأٓكِلُونَ مِنۡهَا فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ","textPlain":"فانهم لاكلون منها فمالون منها البطون","page":448},{"number":67,"text":"ثُمَّ إِنَّ لَهُمۡ عَلَيۡهَا لَشَوۡبٗا مِّنۡ حَمِيمٖ","textPlain":"ثم ان لهم عليها لشوبا من حميم","page":448},{"number":68,"text":"ثُمَّ إِنَّ مَرۡجِعَهُمۡ لَإِلَى ٱلۡجَحِيمِ","textPlain":"ثم ان مرجعهم لالى الجحيم","page":448},{"number":69,"text":"إِنَّهُمۡ أَلۡفَوۡاْ ءَابَآءَهُمۡ ضَآلِّينَ","textPlain":"انهم الفوا ءاباءهم ضالين","page":448},{"number":70,"text":"فَهُمۡ عَلَىٰٓ ءَاثَٰرِهِمۡ يُهۡرَعُونَ","textPlain":"فهم علىٰ ءاثٰرهم يهرعون","page":448},{"number":71,"text":"وَلَقَدۡ ضَلَّ قَبۡلَهُمۡ أَكۡثَرُ ٱلۡأَوَّلِينَ","textPlain":"ولقد ضل قبلهم اكثر الاولين","page":448},{"number":72,"text":"وَلَقَدۡ أَرۡسَلۡنَا فِيهِم مُّنذِرِينَ","textPlain":"ولقد ارسلنا فيهم منذرين","page":448},{"number":73,"text":"فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُنذَرِينَ","textPlain":"فانظر كيف كان عٰقبة المنذرين","page":448},{"number":74,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ","textPlain":"الا عباد الله المخلصين","page":448},{"number":75,"text":"وَلَقَدۡ نَادَىٰنَا نُوحٞ فَلَنِعۡمَ ٱلۡمُجِيبُونَ","textPlain":"ولقد نادىٰنا نوح فلنعم المجيبون","page":448},{"number":76,"text":"وَنَجَّيۡنَٰهُ وَأَهۡلَهُۥ مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ","textPlain":"ونجينٰه واهله من الكرب العظيم","page":448},{"number":78,"text":"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ","textPlain":"وتركنا عليه في الاخرين","page":449},{"number":79,"text":"سَلَٰمٌ عَلَىٰ نُوحٖ فِي ٱلۡعَٰلَمِينَ","textPlain":"سلٰم علىٰ نوح في العٰلمين","page":449},{"number":80,"text":"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","textPlain":"انا كذٰلك نجزي المحسنين","page":449},{"number":81,"text":"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ","textPlain":"انه من عبادنا المؤمنين","page":449},{"number":82,"text":"ثُمَّ أَغۡرَقۡنَا ٱلۡأٓخَرِينَ","textPlain":"ثم اغرقنا الاخرين","page":449},{"number":83,"text":"۞وَإِنَّ مِن 