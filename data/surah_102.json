[{"number":1,"text":"أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ","textPlain":"الهىٰكم التكاثر","page":600},{"number":2,"text":"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ","textPlain":"حتىٰ زرتم المقابر","page":600},{"number":3,"text":"كَلَّا سَوۡفَ تَعۡلَمُونَ","textPlain":"كلا سوف تعلمون","page":600},{"number":4,"text":"ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ","textPlain":"ثم كلا سوف تعلمون","page":600},{"number":5,"text":"كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ","textPlain":"كلا لو تعلمون علم اليقين","page":600},{"number":6,"text":"لَتَرَوُنَّ ٱلۡجَحِيمَ","textPlain":"لترون الجحيم","page":600},{"number":7,"text":"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ","textPlain":"ثم لترونها عين اليقين","page":600},{"number":8,"text":"ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ","textPlain":"ثم لتسلن يومئذ عن النعيم","page":600}]