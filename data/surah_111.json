[{"number":1,"text":"تَبَّتۡ يَدَآ أَبِي لَهَبٖ وَتَبَّ","textPlain":"تبت يدا ابي لهب وتب","page":603},{"number":2,"text":"مَآ أَغۡنَىٰ عَنۡهُ مَالُهُۥ وَمَا كَسَبَ","textPlain":"ما اغنىٰ عنه ماله وما كسب","page":603},{"number":3,"text":"سَيَصۡلَىٰ نَارٗا ذَاتَ لَهَبٖ","textPlain":"سيصلىٰ نارا ذات لهب","page":603},{"number":4,"text":"وَٱمۡرَأَتُهُۥ حَمَّالَةَ ٱلۡحَطَبِ","textPlain":"وامراته حمالة الحطب","page":603},{"number":5,"text":"فِي جِيدِهَا حَبۡلٞ مِّن مَّسَدِۭ","textPlain":"في جيدها حبل من مسد","page":603}]