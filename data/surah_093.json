[{"number":1,"text":"وَٱلضُّحَىٰ","textPlain":"والضحىٰ","page":596},{"number":2,"text":"وَٱلَّيۡلِ إِذَا سَجَىٰ","textPlain":"واليل اذا سجىٰ","page":596},{"number":3,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","textPlain":"ما ودعك ربك وما قلىٰ","page":596},{"number":4,"text":"وَلَلۡأٓخِرَةُ خَيۡرٞ لَّكَ مِنَ ٱلۡأُولَىٰ","textPlain":"وللاخرة خير لك من الاولىٰ","page":596},{"number":5,"text":"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ","textPlain":"ولسوف يعطيك ربك فترضىٰ","page":596},{"number":6,"text":"أَلَمۡ يَجِدۡكَ يَتِيمٗا فَـَٔاوَىٰ","textPlain":"الم يجدك يتيما فاوىٰ","page":596},{"number":7,"text":"وَوَجَدَكَ ضَآلّٗا فَهَدَىٰ","textPlain":"ووجدك ضالا فهدىٰ","page":596},{"number":8,"text":"وَوَجَدَكَ عَآئِلٗا فَأَغۡنَىٰ","textPlain":"ووجدك عائلا فاغنىٰ","page":596},{"number":9,"text":"فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ","textPlain":"فاما اليتيم فلا تقهر","page":596},{"number":10,"text":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ","textPlain":"واما السائل فلا تنهر","page":596},{"number":11,"text":"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ","textPlain":"واما بنعمة ربك فحدث","page":596}]