[{"number":1,"text":"إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ","textPlain":"اذا السماء انشقت","page":589},{"number":2,"text":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ","textPlain":"واذنت لربها وحقت","page":589},{"number":3,"text":"وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ","textPlain":"واذا الارض مدت","page":589},{"number":4,"text":"وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ","textPlain":"والقت ما فيها وتخلت","page":589},{"number":5,"text":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ","textPlain":"واذنت لربها وحقت","page":589},{"number":6,"text":"يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحٗا فَمُلَٰقِيهِ","textPlain":"يٰايها الانسٰن انك كادح الىٰ ربك كدحا فملٰقيه","page":589},{"number":7,"text":"فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ","textPlain":"فاما من اوتي كتٰبه بيمينه","page":589},{"number":8,"text":"فَسَوۡفَ يُحَاسَبُ حِسَابٗا يَسِيرٗا","textPlain":"فسوف يحاسب حسابا يسيرا","page":589},{"number":9,"text":"وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورٗا","textPlain":"وينقلب الىٰ اهله مسرورا","page":589},{"number":10,"text":"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ","textPlain":"واما من اوتي كتٰبه وراء ظهره","page":589},{"number":11,"text":"فَسَوۡفَ يَدۡعُواْ ثُبُورٗا","textPlain":"فسوف يدعوا ثبورا","page":589},{"number":12,"text":"وَيَصۡلَىٰ سَعِيرًا","textPlain":"ويصلىٰ سعيرا","page":589},{"number":13,"text":"إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا","textPlain":"انه كان في اهله مسرورا","page":589},{"number":14,"text":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","textPlain":"انه ظن ان لن يحور","page":589},{"number":15,"text":"بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرٗا","textPlain":"بلىٰ ان ربه كان به بصيرا","page":589},{"number":16,"text":"فَلَآ أُقۡسِمُ بِٱلشَّفَقِ","textPlain":"فلا اقسم بالشفق","page":589},{"number":17,"text":"وَٱلَّيۡلِ وَمَا وَسَقَ","textPlain":"واليل وما وسق","page":589},{"number":18,"text":"وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ","textPlain":"والقمر اذا اتسق","page":589},{"number":19,"text":"لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقٖ","textPlain":"لتركبن طبقا عن طبق","page":589},{"number":20,"text":"فَمَا لَهُمۡ لَا يُؤۡمِنُونَ","textPlain":"فما لهم لا يؤمنون","page":589},{"number":21,"text":"وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩","textPlain":"واذا قرئ عليهم القرءان لا يسجدون","page":589},{"number":22,"text":"بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ","textPlain":"بل الذين كفروا يكذبون","page":589},{"number":23,"text":"وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ","textPlain":"والله اعلم بما يوعون","page":589},{"number":24,"text":"فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ","textPlain":"فبشرهم بعذاب اليم","page":589},{"number":25,"text":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونِۭ","textPlain":"الا الذين ءامنوا وعملوا الصٰلحٰت لهم اجر غير ممنون","page":590}]