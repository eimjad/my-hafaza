[{"number":1,"text":"وَٱلسَّمَآءِ وَٱلطَّارِقِ","textPlain":"والسماء والطارق","page":591},{"number":2,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ","textPlain":"وما ادرىٰك ما الطارق","page":591},{"number":3,"text":"ٱلنَّجۡمُ ٱلثَّاقِبُ","textPlain":"النجم الثاقب","page":591},{"number":4,"text":"إِن كُلُّ نَفۡسٖ لَّمَّا عَلَيۡهَا حَافِظٞ","textPlain":"ان كل نفس لما عليها حافظ","page":591},{"number":5,"text":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ","textPlain":"فلينظر الانسٰن مم خلق","page":591},{"number":6,"text":"خُلِقَ مِن مَّآءٖ دَافِقٖ","textPlain":"خلق من ماء دافق","page":591},{"number":7,"text":"يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ","textPlain":"يخرج من بين الصلب والترائب","page":591},{"number":8,"text":"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ","textPlain":"انه علىٰ رجعه لقادر","page":591},{"number":9,"text":"يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ","textPlain":"يوم تبلى السرائر","page":591},{"number":10,"text":"فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ","textPlain":"فما له من قوة ولا ناصر","page":591},{"number":11,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ","textPlain":"والسماء ذات الرجع","page":591},{"number":12,"text":"وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ","textPlain":"والارض ذات الصدع","page":591},{"number":13,"text":"إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ","textPlain":"انه لقول فصل","page":591},{"number":14,"text":"وَمَا هُوَ بِٱلۡهَزۡلِ","textPlain":"وما هو بالهزل","page":591},{"number":15,"text":"إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا","textPlain":"انهم يكيدون كيدا","page":591},{"number":16,"text":"وَأَكِيدُ كَيۡدٗا","textPlain":"واكيد كيدا","page":591},{"number":17,"text":"فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا","textPlain":"فمهل الكٰفرين امهلهم رويدا","page":591}]