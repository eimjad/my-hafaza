[{"number":1,"text":"وَٱلۡفَجۡرِ","textPlain":"والفجر","page":593},{"number":2,"text":"وَلَيَالٍ عَشۡرٖ","textPlain":"وليال عشر","page":593},{"number":3,"text":"وَٱلشَّفۡعِ وَٱلۡوَتۡرِ","textPlain":"والشفع والوتر","page":593},{"number":4,"text":"وَٱلَّيۡلِ إِذَا يَسۡرِ","textPlain":"واليل اذا يسر","page":593},{"number":5,"text":"هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ","textPlain":"هل في ذٰلك قسم لذي حجر","page":593},{"number":6,"text":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ","textPlain":"الم تر كيف فعل ربك بعاد","page":593},{"number":7,"text":"إِرَمَ ذَاتِ ٱلۡعِمَادِ","textPlain":"ارم ذات العماد","page":593},{"number":8,"text":"ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ","textPlain":"التي لم يخلق مثلها في البلٰد","page":593},{"number":9,"text":"وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِ","textPlain":"وثمود الذين جابوا الصخر بالواد","page":593},{"number":10,"text":"وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ","textPlain":"وفرعون ذي الاوتاد","page":593},{"number":11,"text":"ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ","textPlain":"الذين طغوا في البلٰد","page":593},{"number":12,"text":"فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ","textPlain":"فاكثروا فيها الفساد","page":593},{"number":13,"text":"فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ","textPlain":"فصب عليهم ربك سوط عذاب","page":593},{"number":14,"text":"إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ","textPlain":"ان ربك لبالمرصاد","page":593},{"number":15,"text":"فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ","textPlain":"فاما الانسٰن اذا ما ابتلىٰه ربه فاكرمه ونعمه فيقول ربي اكرمن","page":593},{"number":16,"text":"وَأَمَّآ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ فَيَقُولُ رَبِّيٓ أَهَٰنَنِ","textPlain":"واما اذا ما ابتلىٰه فقدر عليه رزقه فيقول ربي اهٰنن","page":593},{"number":17,"text":"كَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ","textPlain":"كلا بل لا تكرمون اليتيم","page":593},{"number":18,"text":"وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","textPlain":"ولا تحٰضون علىٰ طعام المسكين","page":593},{"number":19,"text":"وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلٗا لَّمّٗا","textPlain":"وتاكلون التراث اكلا لما","page":593},{"number":20,"text":"وَتُحِبُّونَ ٱلۡمَالَ حُبّٗا جَمّٗا","textPlain":"وتحبون المال حبا جما","page":593},{"number":21,"text":"كَلَّآۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكّٗا دَكّٗا","textPlain":"كلا اذا دكت الارض دكا دكا","page":593},{"number":22,"text":"وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفّٗا صَفّٗا","textPlain":"وجاء ربك والملك صفا صفا","page":593},{"number":23,"text":"وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذٖ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ","textPlain":"وجايء يومئذ بجهنم يومئذ يتذكر الانسٰن وانىٰ له الذكرىٰ","page":594},{"number":24,"text":"يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي","textPlain":"يقول يٰليتني قدمت لحياتي","page":594},{"number":25,"text":"فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ","textPlain":"فيومئذ لا يعذب عذابه احد","page":594},{"number":26,"text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞ","textPlain":"ولا يوثق وثاقه احد","page":594},{"number":27,"text":"يَٰٓأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ","textPlain":"يٰايتها النفس المطمئنة","page":594},{"number":28,"text":"ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ","textPlain":"ارجعي الىٰ ربك راضية مرضية","page":594},{"number":29,"text":"فَٱدۡخُلِي فِي عِبَٰدِي","textPlain":"فادخلي في عبٰدي","page":594},{"number":30,"text":"وَٱدۡخُلِي جَنَّتِي","textPlain":"وادخلي جنتي","page":594}]